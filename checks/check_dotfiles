#!/bin/zsh
# check_dotfiles [-v]: checks the whole repo in about a second: every config file parses in the tool that
# reads it, the Claude Code hooks and status line behave, what the docs and comments point at exists, the
# files that describe the same thing agree, and nothing belongs to one Mac. Prints each check that fails with
# its problems and exits 1; -v lists every check with its result and time. A check whose tool isn't installed
# is skipped and says so. The checks that the docs and the conventions agree with the config only warn: their
# problems are printed, but they don't fail the run, since a stale doc table doesn't break the setup. One file
# per group of checks sits next to this one, lib.zsh has what they share. The groups run at the same time.

zmodload zsh/datetime
setopt extended_glob
unsetopt bg_nice  # jobs keep their priority: a sandbox (Claude Code's) can't lower it and zsh would print an error
start=$EPOCHREALTIME
repo=${0:A:h:h}
cd $repo || exit 1
verbose=0
[[ $1 == -v ]] && verbose=1

reset=$'\e[0m' bold=$'\e[1m' green=$'\e[32m' red=$'\e[31m' yellow=$'\e[33m'
tmp=$(mktemp -d ${TMPDIR:-/tmp}/dotfiles.XXXXXX) && tmp=${tmp:A} || exit 1

# every file of the repo: the tracked ones and new ones not yet added, never ignored ones; text_files without
# the GIFs, md_files the Markdown ones, shebangs[file] each text file's #! line
typeset -a files text_files md_files
typeset -A shebangs
for f in ${(f)"$(git ls-files --cached --others --exclude-standard)"}; do
  [[ -f $f ]] && files+=$f
done
text_files=(${files:#*.gif})
md_files=(${(M)text_files:#*.md})
for f in $text_files; do
  line=
  read -r line < $f
  [[ $line == '#!'* ]] && shebangs[$f]=$line
done

source checks/lib.zsh

# group <title>: starts a group of checks; -v prints its title
group() {
  (( verbose )) && print -r -- "$bold$1$reset"
  return 0
}

# check [-w] <label> <function> [args…]: runs one check. The function prints each problem it finds on a line
# of its own (any output fails the check), or prints why it can't run and returns 2 to be skipped. It can set
# `note`, which -v shows after the label (what was checked, how many) with the time the check took. With -w the
# check only warns: its problems are printed under "warn" and don't fail the run. The result goes to the
# group's results file.
check() {
  local warn=0 note= rc out took label
  [[ $1 == -w ]] && { warn=1; shift }
  label=$1
  shift
  # for the report if the check stops the group (a zsh error kills the group's subshell); emptied at the end
  print -r -- $label > $tmp/running.$group_name
  local started=$EPOCHREALTIME
  "$@" > $tmp/out.$group_name 2>&1
  rc=$?
  took="$(printf %.0f $(( (EPOCHREALTIME - started) * 1000 ))) ms"
  out=$(<$tmp/out.$group_name)
  if (( rc == 2 )); then
    print -r -- "skip"$'\t'"$label" >> $tmp/results.$group_name
    (( verbose )) && print -r -- "  ${yellow}skip$reset    $label${out:+: $out}"
  elif (( rc == 0 )) && [[ -z $out ]]; then
    print -r -- "ok"$'\t'"$label" >> $tmp/results.$group_name
    (( verbose )) && print -r -- "  ${green}ok$reset      $label (${note:+$note, }$took)"
  elif (( warn )); then
    print -r -- "warn"$'\t'"$label" >> $tmp/results.$group_name
    print -r -- "  ${yellow}warn$reset    $label${note:+ ($note)}"
    [[ -n $out ]] && print -rl -- ${${(f)out}/#/          }
  else
    print -r -- "failed"$'\t'"$label" >> $tmp/results.$group_name
    print -r -- "  ${red}FAILED$reset  $label${note:+ ($note)}"
    [[ -n $out ]] && print -rl -- ${${(f)out}/#/          }
  fi
  : > $tmp/running.$group_name
  return 0
}

build_indexes

# every group in a subshell of its own, all at once; their output is printed in this order
groups=(syntax behaviour references consistency portability style)
typeset -A pids
for group_name in $groups; do
  ( source checks/$group_name.zsh ) > $tmp/group.$group_name 2>&1 &
  # through a plain variable: zsh stores `pids[x]=$!` as the text $!
  pid=$!
  pids[$group_name]=$pid
done
typeset -a passed failed skipped warned
for group_name in $groups; do
  wait $pids[$group_name]
  rc=$?
  out=$(<$tmp/group.$group_name)
  [[ -n $out ]] && print -r -- $out
  # a group that stops halfway (a zsh error in its file) fails, with what it printed and the error of the check
  # it stopped in; the checks after that one never ran
  if (( rc )); then
    print -r -- "failed"$'\t'"checks/$group_name.zsh runs to its end" >> $tmp/results.$group_name
    if [[ -s $tmp/running.$group_name ]]; then
      print -r -- "  ${red}FAILED$reset  checks/$group_name.zsh stopped in \"$(<$tmp/running.$group_name)\":"
      [[ -s $tmp/out.$group_name ]] && print -rl -- ${${(f)"$(<$tmp/out.$group_name)"}/#/          }
    fi
  fi
  [[ -r $tmp/results.$group_name ]] || continue
  while IFS=$'\t' read -r result label; do
    case $result in
      (ok) passed+=$label ;;
      (skip) skipped+=$label ;;
      (warn) warned+=$label ;;
      (*) failed+=$label ;;
    esac
  done < $tmp/results.$group_name
done

# the temp dir holds only what this run wrote into it
rm -f -- $tmp/**/*(.DN)
rmdir -- $tmp/**/*(/DNod) $tmp 2> /dev/null

seconds=$(printf '%.2f' $(( EPOCHREALTIME - start )))
total=$(( $#passed + $#failed + $#skipped + $#warned ))
warnings=
(( $#warned )) && warnings=", ${yellow}$(count $#warned warning)$reset (${(j:, :)warned})"
if (( $#failed )); then
  print -u2 -r -- "${red}Failed $#failed of $total checks$reset in $seconds s: ${(j:, :)failed}$warnings"
  exit 1
fi
summary="${green}All $#passed checks passed$reset in $seconds s$warnings"
(( $#warned )) && summary="${green}$#passed checks passed$reset in $seconds s$warnings"
(( $#skipped )) && summary+=", $#skipped skipped (${(j:, :)skipped})"
print -r -- $summary
