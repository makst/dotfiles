#!/usr/bin/env zsh
# Usage: windows [--back <window id>] [--result <file>] [fzf options]   |   windows --open [fzf options]   |   windows --list [id]
# AeroSpace's windows, by workspace, as its menu-bar menu shows them, in a picker: workspace, app icon, app and
# window title, ✓ and the cursor on the window --back names (the one you came from). Enter goes to the chosen
# window (its workspace with it), 1-9 to that workspace, m moves your window to the chosen one's workspace and
# follows it, d closes the chosen window; q or Esc goes back. Keys as in every picker (config/tmux/picker.zsh):
# it opens in normal mode, j/k move, / filters, ? lists the keys. Arguments go to fzf.
# `windows --open` is what alt+w runs (config/aerospace/aerospace.toml), from any app: it opens the picker in
# a Ghostty window of its own, floating over the workspace you're on (--result), or, when Ghostty won't start,
# in a tmux popup in the Ghostty window of the tmux client used last.
# `windows --list` prints the lines alone. Linked to ~/.config/aerospace/windows by setup_aerospace.
source ${0:A:h}/../tmux/picker.zsh
# AeroSpace starts it without LANG: tmux would print the · in titles as _, and printf would count bytes, not
# letters, when it lines up the columns
[[ -n $LANG ]] || export LANG=en_US.UTF-8
self=${0:A}

# focus_state: the focused window and workspace, to tell whether a switch held
function focus_state() {
  print -r -- "$(aerospace list-windows --focused --format '%{window-id}') $(aerospace list-workspaces --focused)"
}

if [[ $1 == --open ]]; then
  shift
  # exec-and-forget shows no errors: they go to a log, overwritten each time
  exec 2> ${TMPDIR:-/tmp}/aerospace-windows.log
  back=$(aerospace list-windows --focused --format '%{window-id}')
  lines=$(aerospace list-windows --monitor all --count)
  # as big as the list (a line each, the header, the input and the borders), centred on the main display:
  # Ghostty places a window in points from the display's top-left, and a cell of a monospace font is 0.6 of
  # the font size wide and, with adjust-cell-height, about 1.4 high
  cols=120 rows=$(( lines + 7 ))
  screen=(${="$(osascript -l JavaScript -e 'ObjC.import("AppKit")
    const f = $.NSScreen.screens.objectAtIndex(0).frame; f.size.width + " " + f.size.height')"})
  font=$(/Applications/Ghostty.app/Contents/MacOS/ghostty +show-config | awk '$1 == "font-size" { print $3 }')
  (( x = (screen[1] - cols * font * 0.6) / 2, y = (screen[2] - rows * font * 1.4) / 2 ))
  # A Ghostty of its own (open -n), so the options are this window's alone: its title from the start, which
  # AeroSpace's rule floats before it tiles it; no saved windows restored or saved; it quits with the picker,
  # and open -W waits for that. The picker makes the result file when it starts.
  result=$(mktemp -u -t aerospace-windows)
  open -W -na Ghostty --args --title=aerospace-windows --window-save-state=never \
    --quit-after-last-window-closed=true --macos-titlebar-style=hidden \
    --window-width=$cols --window-height=$rows --window-position-x=${x%.*} --window-position-y=${y%.*} \
    -e "$self" --back ${back:-0} --result $result "$@"
  if [[ -e $result ]]; then
    # The switch is made here, not in the picker: a quitting app hands focus to the app active before it, up
    # to ~200 ms later, which would undo it, and a switch, that hand-back and the switch again flicker. So:
    # wait out the hand-back (0.2 s, and until the window you came from, already on screen under the picker,
    # has focus, 0.4 s at most), switch once, and switch again whenever the focus leaves it, for a second. The result is the switch, then the
    # command that makes it again (a moved window isn't moved twice), each word on a line and a blank between.
    done=("${(@f)"$(< $result)"}")
    rm -f $result
    if (( $#done > 1 )); then
      action=(${done[1,${done[(i)]}-1]}) again=(${done[${done[(i)]}+1,-1]})
      zmodload zsh/datetime
      typeset -F end=$(( EPOCHREALTIME + 0.4 ))
      sleep 0.2
      while [[ -n $back ]] && (( EPOCHREALTIME < end )) &&
        [[ $(aerospace list-windows --focused --format '%{window-id}') != $back ]]; do
        sleep 0.01
      done
      aerospace $action
      state=$(focus_state)
      (( end = EPOCHREALTIME + 1 ))
      while (( EPOCHREALTIME < end )); do
        sleep 0.02
        [[ $(focus_state) == $state ]] || aerospace $again
      done
    fi
    exit 0
  fi
  # Ghostty didn't start: a tmux popup. Ghostty's title is tmux's set-titles-string ("#S · #W",
  # config/tmux/tmux.conf), which tells which Ghostty window shows which client; the client used last wins, the first Ghostty window when no title matches.
  typeset -A ghostty
  for line in ${(f)"$(aerospace list-windows --monitor all --app-bundle-id com.mitchellh.ghostty \
    --format '%{window-title}'$'\t''%{window-id}')"}; do
    ghostty[${line%$'\t'*}]=${line##*$'\t'}
  done
  if (( ! $#ghostty )); then
    open -a Ghostty # no terminal yet: alt+w again once it's there
    exit 0
  fi
  client= window=
  for line in ${(f)"$(tmux list-clients -F '#{client_activity}'$'\t''#{client_name}'$'\t''#S · #W' | sort -rn)"}; do
    fields=("${(@ps:\t:)line}")
    [[ -z $client ]] && client=$fields[2]
    if [[ -n ${ghostty[$fields[3]]} ]]; then
      client=$fields[2] window=${ghostty[$fields[3]]}
      break
    fi
  done
  ids=(${(v)ghostty})
  aerospace focus --window-id ${window:-$ids[1]}
  [[ -n $client ]] || exit 0
  tmux display-popup -c $client -E -B -x '#{E:@popup-x}' -y '#{E:@popup-y}' -w 80% -h $(( lines + 8 )) \
    "$self --back ${back:-0} --height=100% ${(j: :)${(q)@}}"
  exit 0
fi

# icon <app name>: the app's Nerd Font icon, a window for the ones it doesn't know
function icon() {
  case $1 in
    Ghostty) print -n $'' ;;
    Firefox*) print -n $'' ;;
    *Chrome*) print -n $'' ;;
    Safari) print -n $'' ;;
    Brave*|Arc) print -n $'\U000f059f' ;;
    Slack) print -n $'\U000f04b1' ;;
    Claude|ChatGPT) print -n $'\U000f06a9' ;;
    Code|*Visual\ Studio\ Code*) print -n $'\U000f0a1e' ;;
    Xcode|Simulator) print -n $'\U000f0035' ;;
    Android\ Studio|qemu*) print -n $'\U000f0032' ;;
    Finder) print -n $'\U000f024b' ;;
    Mail|Mimestream) print -n $'\U000f01ee' ;;
    Calendar) print -n $'\U000f00ed' ;;
    Spotify|Music) print -n $'\U000f04c7' ;;
    zoom.us|FaceTime) print -n $'\U000f0567' ;;
    *) print -n $'' ;;
  esac
}

# each line is "window id<tab>what fzf shows<tab>workspace", by workspace and in AeroSpace's order within one;
# fzf shows the second field only
if [[ $1 == --list ]]; then
  current=${2:-$(aerospace list-windows --focused --format '%{window-id}')}
  aerospace list-windows --monitor all --format '%{workspace}'$'\t''%{window-id}'$'\t''%{app-name}'$'\t''%{window-title}' |
    sort -s -t $'\t' -k 1,1n |
    while IFS=$'\t' read -r workspace id app title; do
      # the picker's own window isn't one to go to
      [[ $title == aerospace-windows ]] && continue
      mark=' '
      [[ $id == $current ]] && mark=$'\e[32m✓\e[0m'
      printf '%s\t%s %s  %s %-16s \e[2m%s\e[0m\t%s\n' $id $mark $workspace "$(icon $app)" $app $title $workspace
    done
  exit 0
fi

back= result=
while [[ $1 == --back || $1 == --result ]]; do
  case $1 in
    --back) back=$2; shift 2 ;;
    --result) result=$2; shift 2 ;;
  esac
done
[[ $back == 0 ]] && back=
# a Ghostty started by open gets launchd's environment, not the shell's: Homebrew's PATH and fzf's options
# file, as tmux gives its popups (config/tmux/tmux.conf)
if [[ -n $result ]]; then
  : > $result
  path=(/opt/homebrew/bin $path)
  export FZF_DEFAULT_OPTS_FILE=$HOME/.config/tmux/../fzf/fzfrc
fi

list=$("$self" --list $back)
# the cursor starts on the window you came from
pos=
if [[ -n $back ]]; then
  lines=(${(f)list})
  pos=${lines[(i)$back$'\t'*]}
fi
keys=m:alt-m,d:alt-d
binds=()
for n in {1..9}; do
  keys+=,${n}:alt-$n
  binds+=(--bind "alt-$n:become(echo workspace $n)")
done
choice=$(print -r -- $list | picker window --keys $keys \
  --header 'Enter go · 1-9 workspace · m move yours there · d close · / filter · q back' \
  --bind "load:pos(${pos:-1})+unbind(load)" $binds \
  --bind "alt-m:become(echo move {3})" \
  --bind "alt-d:execute-silent(aerospace close --window-id {1})+reload-sync('$self' --list $back)" "$@")
# the switch, and what --open does again if macOS undoes it (moving the window again isn't needed)
action=() again=()
case $choice in
  workspace\ *) action=(workspace ${choice#* }) ;;
  move\ *) [[ -n $back ]] && action=(move-node-to-workspace --window-id $back --focus-follows-window ${choice#* })
    again=(focus --window-id $back) ;;
  ?*) action=(focus --window-id "${choice%%$'\t'*}") ;;
  *) [[ -n $back ]] && action=(focus --window-id $back) ;;
esac
(( $#action )) || exit 0
(( $#again )) || again=($action)
# in its own Ghostty, --open switches once that has quit (see there)
if [[ -n $result ]]; then
  print -rl -- $action '' $again > $result
else
  aerospace $action
fi
exit 0
