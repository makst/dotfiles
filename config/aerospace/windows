#!/usr/bin/env zsh
# Usage: windows [--back <window id>] [--result <file>] [fzf options]   |   windows --open [fzf options]   |   windows --list [id]
# AeroSpace's windows, by workspace, as its menu-bar menu shows them, in a picker: workspace, app icon, app and
# window title, ✓ and the cursor on the window --back names (the one you came from). Enter goes to the chosen
# window (its workspace with it), 1-9 to that workspace, m moves your window to the chosen one's workspace and
# follows it, d closes the chosen window; q or Esc goes back. Keys as in every picker (config/tmux/picker.zsh):
# it opens in normal mode, j/k move, / filters, ? lists the keys. Arguments go to fzf.
# `windows --open` is what alt+w runs (config/aerospace/aerospace.toml), from any app: it opens the picker in
# a Ghostty window of its own, floating over the workspace you're on (--result), or, when Ghostty won't start,
# in a tmux popup in the Ghostty window of the tmux client used last.
# `windows --list` prints the lines alone. Linked to ~/.config/aerospace/windows by setup_aerospace.
source ${0:A:h}/../tmux/picker.zsh
# AeroSpace starts it without LANG: tmux would print the · in titles as _, and printf would count bytes, not
# letters, when it lines up the columns
[[ -n $LANG ]] || export LANG=en_US.UTF-8
self=${0:A}

# focus_state: the focused window and workspace, to tell whether a switch held
function focus_state() {
  print -r -- "$(aerospace list-windows --focused --format '%{window-id}') $(aerospace list-workspaces --focused)"
}

if [[ $1 == --open ]]; then
  shift
  # exec-and-forget shows no errors: they go to a log, overwritten each time
  exec 2> ${TMPDIR:-/tmp}/aerospace-windows.log
  back=$(aerospace list-windows --focused --format '%{window-id}')
  # the list's lines (config/aerospace/windows --list without its icons and marks): a window each, a workspace
  # with more than one and, with two displays or more, a display each
  typeset -A per
  for workspace in ${(f)"$(aerospace list-windows --monitor all --format '%{workspace}')"}; do (( per[$workspace]++ )); done
  lines=0
  for n in ${(v)per}; do (( lines += n > 1 ? n + 1 : 1 )); done
  displays=$(aerospace list-monitors --count)
  (( displays > 1 )) && (( lines += displays ))
  # as big as the list (a line each, the header, the input and the borders), centred on the main display:
  # Ghostty places a window in points from the display's top-left, and a cell of a monospace font is 0.6 of
  # the font size wide and, with adjust-cell-height, about 1.4 high
  cols=120 rows=$(( lines + 7 ))
  screen=(${="$(osascript -l JavaScript -e 'ObjC.import("AppKit")
    const f = $.NSScreen.screens.objectAtIndex(0).frame; f.size.width + " " + f.size.height')"})
  font=$(/Applications/Ghostty.app/Contents/MacOS/ghostty +show-config | awk '$1 == "font-size" { print $3 }')
  (( x = (screen[1] - cols * font * 0.6) / 2, y = (screen[2] - rows * font * 1.4) / 2 ))
  # A Ghostty of its own (open -n), so the options are this window's alone: its title from the start, which
  # AeroSpace's rule floats before it tiles it; no saved windows restored or saved; it quits with the picker,
  # and open -W waits for that. The picker makes the result file when it starts.
  result=$(mktemp -u -t aerospace-windows)
  open -W -na Ghostty --args --title=aerospace-windows --window-save-state=never \
    --quit-after-last-window-closed=true --macos-titlebar-style=hidden \
    --window-width=$cols --window-height=$rows --window-position-x=${x%.*} --window-position-y=${y%.*} \
    -e "$self" --back ${back:-0} --result $result "$@"
  if [[ -e $result ]]; then
    # The switch is made here, not in the picker: a quitting app hands focus to the app active before it, up
    # to ~200 ms later, which would undo it, and a switch, that hand-back and the switch again flicker. So:
    # wait out the hand-back (0.2 s, and until the window you came from, already on screen under the picker,
    # has focus, 0.4 s at most), switch once, and switch again whenever the focus leaves it, for a second. The
    # result is the command that switches, then the one that does it again (a moved window isn't moved twice,
    # a workspace isn't arranged twice), each word on a line and a blank between.
    done=("${(@f)"$(< $result)"}")
    rm -f $result
    if (( $#done > 1 )); then
      action=(${done[1,${done[(i)]}-1]}) again=(${done[${done[(i)]}+1,-1]})
      zmodload zsh/datetime
      typeset -F end=$(( EPOCHREALTIME + 0.4 ))
      sleep 0.2
      while [[ -n $back ]] && (( EPOCHREALTIME < end )) &&
        [[ $(aerospace list-windows --focused --format '%{window-id}') != $back ]]; do
        sleep 0.01
      done
      $action
      state=$(focus_state)
      (( end = EPOCHREALTIME + 1 ))
      while (( EPOCHREALTIME < end )); do
        sleep 0.02
        [[ $(focus_state) == $state ]] || $again
      done
    fi
    exit 0
  fi
  # Ghostty didn't start: a tmux popup. Ghostty's title is tmux's set-titles-string ("#S · #W",
  # config/tmux/tmux.conf), which tells which Ghostty window shows which client; the client used last wins, the first Ghostty window when no title matches.
  typeset -A ghostty
  for line in ${(f)"$(aerospace list-windows --monitor all --app-bundle-id com.mitchellh.ghostty \
    --format '%{window-title}'$'\t''%{window-id}')"}; do
    ghostty[${line%$'\t'*}]=${line##*$'\t'}
  done
  if (( ! $#ghostty )); then
    open -a Ghostty # no terminal yet: alt+w again once it's there
    exit 0
  fi
  client= window=
  for line in ${(f)"$(tmux list-clients -F '#{client_activity}'$'\t''#{client_name}'$'\t''#S · #W' | sort -rn)"}; do
    fields=("${(@ps:\t:)line}")
    [[ -z $client ]] && client=$fields[2]
    if [[ -n ${ghostty[$fields[3]]} ]]; then
      client=$fields[2] window=${ghostty[$fields[3]]}
      break
    fi
  done
  ids=(${(v)ghostty})
  aerospace focus --window-id ${window:-$ids[1]}
  [[ -n $client ]] || exit 0
  tmux display-popup -c $client -E -B -x '#{E:@popup-x}' -y '#{E:@popup-y}' -w 80% -h $(( lines + 8 )) \
    "$self --back ${back:-0} --height=100% ${(j: :)${(q)@}}"
  exit 0
fi

# icon <app name>: the app's Nerd Font icon, a window for the ones it doesn't know
function icon() {
  case $1 in
    Ghostty) print -n $'' ;;
    Firefox*) print -n $'' ;;
    *Chrome*) print -n $'' ;;
    Safari) print -n $'' ;;
    Brave*|Arc) print -n $'\U000f059f' ;;
    Slack) print -n $'\U000f04b1' ;;
    Claude|ChatGPT) print -n $'\U000f06a9' ;;
    Code|*Visual\ Studio\ Code*) print -n $'\U000f0a1e' ;;
    Xcode|Simulator) print -n $'\U000f0035' ;;
    Android\ Studio|qemu*) print -n $'\U000f0032' ;;
    Finder) print -n $'\U000f024b' ;;
    Mail|Mimestream) print -n $'\U000f01ee' ;;
    Calendar) print -n $'\U000f00ed' ;;
    Spotify|Music) print -n $'\U000f04c7' ;;
    zoom.us|FaceTime) print -n $'\U000f0567' ;;
    *) print -n $'' ;;
  esac
}

# rows: the windows, a line each: "display id<tab>workspace<tab>window id<tab>app<tab>title", by display, then by
# workspace, in AeroSpace's order within one; without the picker's own window, which isn't one to go to
function rows() {
  aerospace list-windows --monitor all --format "$(print -r -- '%{monitor-id}' '%{workspace}' '%{window-id}' \
    '%{app-name}' '%{window-title}' | tr ' ' '\t')" | sort -s -t $'\t' -k 1,1n -k 2,2n |
    awk -F '\t' '$5 != "aerospace-windows"'
}

# The list as a tree, drawn as tmux's tree (config/tmux/tree) draws its sessions: a workspace with one window
# on a line of its own, one with more as a line with its windows under it; with two displays or more, each
# display (a laptop icon for the built-in one, a monitor for the others) with its workspaces under it. Each
# line is "key<tab>what fzf shows<tab>workspace": the key is the window's id, workspace:<name> or
# monitor:<id>; fzf shows the second field only.
if [[ $1 == --list ]]; then
  current=${2:-$(aerospace list-windows --focused --format '%{window-id}')}
  rows=(${(f)"$(rows)"})
  typeset -A display windows workspaces last_workspace
  for line in ${(f)"$(aerospace list-monitors --format '%{monitor-id}'$'\t''%{monitor-name}')"}; do
    display[${line%%$'\t'*}]=${line#*$'\t'}
  done
  for line in $rows; do
    f=("${(@ps:\t:)line}")
    (( windows[$f[2]]++ )) || (( workspaces[$f[1]]++ ))
    last_workspace[$f[1]]=$f[2]
  done
  # the window columns line up: the tree's part is as wide on every line
  (( $#display > 1 )) && width=8 || width=4
  monitor= workspace=
  for i in {1..$#rows}; do
    f=("${(@ps:\t:)rows[i]}")
    next=("${(@ps:\t:)rows[i+1]}")
    branch= stem=
    if (( $#display > 1 )); then
      if [[ $f[1] != $monitor ]]; then
        monitor=$f[1]
        [[ $display[$monitor] == Built-in* ]] && kind=$'\U000f0322' || kind=$'\U000f0379'
        print -r -- "monitor:$monitor"$'\t'"  $kind $display[$monitor]: $workspaces[$monitor] workspace${${workspaces[$monitor]:#1}:+s}"$'\t'
      fi
      [[ $last_workspace[$monitor] == $f[2] ]] && branch='└─> ' stem='    ' || branch='├─> ' stem='│   '
    fi
    mark=' '
    [[ $f[3] == $current ]] && mark=$'\e[32m✓\e[0m'
    window="$(icon $f[4]) ${(r:16:)f[4]} "$'\e[2m'"$f[5]"$'\e[0m'
    if (( windows[$f[2]] == 1 )); then
      print -r -- "$f[3]"$'\t'"$mark ${(r:width:)${:-$branch$f[2]}} $window"$'\t'"$f[2]"
      continue
    fi
    if [[ $f[2] != $workspace ]]; then
      workspace=$f[2]
      print -r -- "workspace:$workspace"$'\t'"  $branch$workspace: $windows[$workspace] windows"$'\t'"$workspace"
    fi
    [[ $next[2] == $f[2] ]] && twig='├─> ' || twig='└─> '
    print -r -- "$f[3]"$'\t'"$mark ${(r:width:)${:-$stem$twig}} $window"$'\t'"$f[2]"
  done
  exit 0
fi

# the layouts t arranges a workspace in, as "name<tab>what fzf shows"
layouts=(
  $'tiles\tside by side, all the same width'
  $'rows\tstacked, all the same height'
  $'main\tone big window on the left, the others stacked on the right'
  $'grid\tin columns of two'
  $'accordion\tone at a time, the others behind it (alt+s)'
)

# --draw <layout>: a drawing of the layout, for the preview of t's list
if [[ $1 == --draw ]]; then
  case $2 in
    tiles) print -l '┌──────┬──────┬──────┐' '│      │      │      │' '│  1   │  2   │  3   │' '│      │      │      │' \
      '│      │      │      │' '└──────┴──────┴──────┘' ;;
    rows) print -l '┌────────────────────┐' '│         1          │' '├────────────────────┤' '│         2          │' \
      '├────────────────────┤' '│         3          │' '└────────────────────┘' ;;
    main) print -l '┌────────────┬───────┐' '│            │   2   │' '│            ├───────┤' '│     1      │   3   │' \
      '│            ├───────┤' '│            │   4   │' '└────────────┴───────┘' ;;
    grid) print -l '┌──────────┬─────────┐' '│    1     │    3    │' '│          │         │' '├──────────┼─────────┤' \
      '│    2     │    4    │' '│          │         │' '└──────────┴─────────┘' ;;
    accordion) print -l '┌────────────────────┐' '│                    │' '│   1  (2, 3 behind) │' '│                    │' \
      '│                    │' '└────────────────────┘' ;;
  esac
  exit 0
fi

# --layout <workspace>: t's list of layouts, in the picker's window; prints "layout <name> <workspace>" for
# the one chosen, nothing on q
if [[ $1 == --layout ]]; then
  [[ -n $2 ]] || exit 0
  # the preview on the right, not below as in the other pickers: the window is only as high as the windows' list
  choice=$(print -rl -- $layouts | picker layout \
    --header "Enter arranges workspace $2 · q back" --preview "'${0:A}' --draw {1}" --preview-window nohidden,right,50%)
  [[ -n $choice ]] && print -r -- "layout ${choice%%$'\t'*} $2"
  exit 0
fi

# --arrange <layout> <workspace> [window id…]: goes to the workspace and arranges its tiled windows (not the
# floating ones) in the layout, the windows given first, in that order, then the others in the order they're
# in now: first every window in one row, then the layout's steps
if [[ $1 == --arrange ]]; then
  layout=$2 workspace=$3
  ids=(${(f)"$(aerospace list-windows --workspace $workspace --format '%{window-id}'$'\t''%{window-layout}' |
    awk -F '\t' '$2 != "floating" { print $1 }')"})
  (( $#ids )) || exit 0
  aerospace workspace $workspace
  aerospace flatten-workspace-tree --workspace $workspace
  case $layout in
    rows) aerospace layout --window-id $ids[1] v_tiles ;;
    accordion) aerospace layout --window-id $ids[1] h_accordion ;;
    *) aerospace layout --window-id $ids[1] h_tiles ;;
  esac
  # in one row now: each window given swapped back to its place, one neighbour at a time
  i=0
  for id in ${@[4,-1]}; do
    j=${ids[(i)$id]}
    (( j <= $#ids )) || continue
    (( i++ ))
    while (( j > i )); do
      aerospace swap --window-id $id dfs-prev
      ids[j]=$ids[j-1] ids[j-1]=$id
      (( j-- ))
    done
  done
  case $layout in
    # 2 and 3 joined in a column, then 4 and the others moved into it
    main) if (( $#ids > 2 )); then
        aerospace join-with --window-id $ids[3] left
        for id in ${ids[4,-1]}; do aerospace move --window-id $id left; done
      fi ;;
    # each even window joined with the one before it, in a column
    grid) for i in {2..$#ids..2}; do aerospace join-with --window-id $ids[i] left; done ;;
  esac
  aerospace balance-sizes --workspace $workspace
  # the main window 60% of its display's width
  if [[ $layout == main ]] && (( $#ids > 1 )); then
    screen=$(aerospace list-workspaces --all --format '%{workspace}'$'\t''%{monitor-appkit-nsscreen-screens-id}' |
      awk -F '\t' -v w=$workspace '$1 == w { print $2 }')
    width=$(osascript -l JavaScript -e "ObjC.import('AppKit')
      \$.NSScreen.screens.objectAtIndex(${screen:-1} - 1).frame.size.width" 2> /dev/null)
    width=${width%.*}
    [[ $width == <-> ]] && aerospace resize --window-id $ids[1] width $(( width * 6 / 10 ))
  fi
  exit 0
fi

# arrangements <file>: the arrangements file's lines (config/machine/arrangements has the format), without
# comments and blank lines, as "line number<tab>name<tab>displays<tab>display<tab>workspace<tab>shape<tab>apps",
# the apps joined by commas without the spaces around them
function arrangements() {
  setopt local_options extended_glob
  local n=0 line name displays display workspace shape apps
  local -a list
  while IFS= read -r line; do
    (( n++ ))
    line=${line%%\#*}
    [[ $line == *[^[:space:]]* ]] || continue
    read -r name displays display workspace shape apps <<< $line
    list=(${${${(s:,:)apps}##[[:space:]]#}%%[[:space:]]#})
    print -r -- "$n"$'\t'"$name"$'\t'"$displays"$'\t'"$display"$'\t'"$workspace"$'\t'"$shape"$'\t'"${(j:,:)list}"
  done < $1
}

# --check <file>: what's wrong with an arrangements file, a line each; nothing when it's right. check_dotfiles
# runs it on config/machine/arrangements and on this Mac's copy.
if [[ $1 == --check ]]; then
  typeset -A displays seen
  for line in ${(f)"$(arrangements $2)"}; do
    f=("${(@ps:\t:)line}")
    at="$2:$f[1]"
    if [[ -z $f[7] ]]; then
      print -r -- "$at: needs <name> <displays> <main|secondary> <workspace> <shape> <app>[, <app>…]"
      continue
    fi
    [[ $f[3] == <1-> ]] || print -r -- "$at: the number of displays is a number, not '$f[3]'"
    [[ $f[4] == (main|secondary) ]] || print -r -- "$at: the display is main or secondary, not '$f[4]'"
    [[ $f[4] == secondary && $f[3] == 1 ]] && print -r -- "$at: no secondary display in an arrangement for one"
    [[ $f[6] == (tiles|rows|main|grid|accordion) ]] ||
      print -r -- "$at: the shape is tiles, rows, main, grid or accordion, not '$f[6]'"
    [[ -n $displays[$f[2]] && $displays[$f[2]] != $f[3] ]] &&
      print -r -- "$at: $f[2]'s first line says $displays[$f[2]] for the number of displays"
    displays[$f[2]]=${displays[$f[2]]:-$f[3]}
    key="$f[2]:workspace $f[5]"
    [[ -n $seen[$key] ]] && print -r -- "$at: workspace $f[5] is in $f[2] twice"
    seen[$key]=1
    for app in ${(s:,:)f[7]}; do
      [[ -n $seen[$f[2]:$app] ]] && print -r -- "$at: $app is in $f[2] twice"
      seen[$f[2]:$app]=1
    done
  done
  exit 0
fi

# --apply <name>: applies an arrangement from ~/.config/dotfiles/arrangements: every window of each app it
# names to that app's workspace, each workspace to its display, arranged in its shape with the apps in their
# order, and each display showing its workspace, the first line's with the focus. Refuses one made for another
# number of displays; says which apps had no window.
if [[ $1 == --apply ]]; then
  file=~/.config/dotfiles/arrangements tab=$'\t'
  lines=(${(M)${(f)"$(arrangements $file)"}:#<->$tab$2$tab*})
  if (( ! $#lines )); then
    print -u2 -r -- "no arrangement '$2' in $file"
    exit 1
  fi
  f=("${(@ps:\t:)lines[1]}")
  have=$(aerospace list-monitors --count)
  if (( f[3] != have )); then
    print -u2 -r -- "$2 is for $f[3] displays, and there are $have"
    exit 1
  fi
  typeset -A by_app order
  for row in ${(f)"$(rows)"}; do
    r=("${(@ps:\t:)row}")
    by_app[$r[4]]+=" $r[3]"
  done
  skipped=()
  for line in $lines; do
    f=("${(@ps:\t:)line}")
    for app in ${(s:,:)f[7]}; do
      ids=(${=by_app[$app]})
      (( $#ids )) || { skipped+=$app; continue }
      for id in $ids; do aerospace move-node-to-workspace --window-id $id $f[5]; done
      order[$f[5]]+=" $ids"
    done
  done
  for line in $lines; do
    f=("${(@ps:\t:)line}")
    (( have > 1 )) && aerospace move-workspace-to-monitor --workspace $f[5] $f[4]
    "$self" --arrange $f[6] $f[5] ${=order[$f[5]]}
  done
  for line in ${(Oa)lines}; do
    f=("${(@ps:\t:)line}")
    aerospace workspace $f[5]
  done
  (( $#skipped )) && print -r -- "no windows of ${(j:, :)skipped}: left out"
  exit 0
fi

back= result=
while [[ $1 == --back || $1 == --result ]]; do
  case $1 in
    --back) back=$2; shift 2 ;;
    --result) result=$2; shift 2 ;;
  esac
done
[[ $back == 0 ]] && back=
# a Ghostty started by open gets launchd's environment, not the shell's: Homebrew's PATH and fzf's options
# file, as tmux gives its popups (config/tmux/tmux.conf)
if [[ -n $result ]]; then
  : > $result
  path=(/opt/homebrew/bin $path)
  export FZF_DEFAULT_OPTS_FILE=$HOME/.config/tmux/../fzf/fzfrc
fi

list=$("$self" --list $back)
# the cursor starts on the window you came from
pos=
if [[ -n $back ]]; then
  # $'\t' isn't expanded inside a subscript: a tab in a variable is
  lines=(${(f)list}) tab=$'\t'
  pos=${lines[(i)$back$tab*]}
fi
keys=m:alt-m,d:alt-d,t:alt-t
binds=()
for n in {1..9}; do
  keys+=,${n}:alt-$n
  binds+=(--bind "alt-$n:become(echo workspace $n)")
done
# d closes a window, not a whole workspace or display: on their lines it does nothing
choice=$(print -r -- $list | picker window --keys $keys \
  --header 'Enter go · 1-9 workspace · m move yours there · t layout · d close · / filter · q back' \
  --bind "load:pos(${pos:-1})+unbind(load)" $binds \
  --bind "alt-m:become(echo move {1} {3})" \
  --bind "alt-t:become('$self' --layout {3})" \
  --bind "alt-d:execute-silent(case {1} in *[!0-9]*) ;; *) aerospace close --window-id {1} ;; esac)+reload-sync('$self' --list $back)" "$@")
# the command that switches, and what --open does again if macOS undoes it (moving the window again isn't
# needed, nor arranging the workspace again)
action=() again=()
choice=${choice%%$'\t'*}
case $choice in
  workspace\ *) action=(aerospace workspace ${choice#* }) ;;
  move\ monitor:*) [[ -n $back ]] && action=(aerospace move-node-to-monitor --window-id $back --focus-follows-window
    ${${choice#move monitor:}%% *}) again=(aerospace focus --window-id $back) ;;
  move\ *) [[ -n $back && -n ${choice##* } ]] && action=(aerospace move-node-to-workspace --window-id $back
    --focus-follows-window ${choice##* }) again=(aerospace focus --window-id $back) ;;
  layout\ *) words=(${=choice}) action=("$self" --arrange $words[2] $words[3]) again=(aerospace workspace $words[3]) ;;
  workspace:*) action=(aerospace workspace ${choice#*:}) ;;
  monitor:*) action=(aerospace focus-monitor ${choice#*:}) ;;
  ?*) action=(aerospace focus --window-id $choice) ;;
  *) [[ -n $back ]] && action=(aerospace focus --window-id $back) ;;
esac
(( $#action )) || exit 0
(( $#again )) || again=($action)
# in its own Ghostty, --open switches once that has quit (see there)
if [[ -n $result ]]; then
  print -rl -- $action '' $again > $result
else
  $action
fi
exit 0
