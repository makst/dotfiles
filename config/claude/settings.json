{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.aws/cli/cache/**)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * modify-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws * run-*)",
      "Bash(aws * start-*)",
      "Bash(aws * stop-*)",
      "Bash(aws * reboot-*)",
      "Bash(aws * restore-*)",
      "Bash(aws * attach-*)",
      "Bash(aws * detach-*)",
      "Bash(aws * associate-*)",
      "Bash(aws * disassociate-*)",
      "Bash(aws * add-*)",
      "Bash(aws * remove-*)",
      "Bash(aws * register-*)",
      "Bash(aws * deregister-*)",
      "Bash(aws * enable-*)",
      "Bash(aws * disable-*)",
      "Bash(aws * import-*)",
      "Bash(aws * execute-*)",
      "Bash(aws * send-*)",
      "Bash(aws * set-*)",
      "Bash(aws * reset-*)",
      "Bash(aws * authorize-*)",
      "Bash(aws * revoke-*)",
      "Bash(aws * tag-*)",
      "Bash(aws * untag-*)",
      "Bash(aws * upload-*)",
      "Bash(aws * copy-*)",
      "Bash(aws * cancel-*)",
      "Bash(aws * rotate-*)",
      "Bash(aws * invoke*)",
      "Bash(aws * publish*)",
      "Bash(aws * deploy*)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3 mb *)",
      "Bash(aws s3 mv *)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3 sync *)",
      "Bash(aws configure set *)",
      "Bash(aws configure sso*)",
      "Bash(*cdk deploy*)",
      "Bash(*cdk destroy*)",
      "Bash(*cdk bootstrap*)",
      "Bash(*cdk import*)",
      "Bash(*cdk watch*)",
      "Bash(*cdk rollback*)",
      "Bash(gcloud * create *)",
      "Bash(gcloud * create)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * delete)",
      "Bash(gcloud * deploy *)",
      "Bash(gcloud * deploy)",
      "Bash(gcloud * update *)",
      "Bash(gcloud * update)",
      "Bash(gcloud * patch *)",
      "Bash(gcloud * patch)",
      "Bash(gcloud * import *)",
      "Bash(gcloud * import)",
      "Bash(gcloud * enable *)",
      "Bash(gcloud * enable)",
      "Bash(gcloud * disable *)",
      "Bash(gcloud * disable)",
      "Bash(gcloud * start *)",
      "Bash(gcloud * start)",
      "Bash(gcloud * stop *)",
      "Bash(gcloud * stop)",
      "Bash(gcloud * reset *)",
      "Bash(gcloud * reset)",
      "Bash(gcloud * resize *)",
      "Bash(gcloud * resize)",
      "Bash(gcloud * rollback *)",
      "Bash(gcloud * rollback)",
      "Bash(gcloud * publish *)",
      "Bash(gcloud * publish)",
      "Bash(gcloud * execute *)",
      "Bash(gcloud * execute)",
      "Bash(gcloud * set-iam-policy *)",
      "Bash(gcloud * set-iam-policy)",
      "Bash(gcloud * add-iam-policy-binding *)",
      "Bash(gcloud * add-iam-policy-binding)",
      "Bash(gcloud * remove-iam-policy-binding *)",
      "Bash(gcloud * remove-iam-policy-binding)",
      "Bash(gcloud config set *)",
      "Bash(gcloud storage rm *)",
      "Bash(gcloud storage mv *)",
      "Bash(gcloud storage cp *)",
      "Bash(gcloud storage rsync *)",
      "Bash(bq rm *)",
      "Bash(bq mk *)",
      "Bash(bq load *)",
      "Bash(bq cp *)",
      "Bash(bq update *)",
      "Bash(bq insert *)",
      "Bash(bq truncate *)",
      "Bash(gsutil rm *)",
      "Bash(gsutil * rm *)",
      "Bash(gsutil mv *)",
      "Bash(gsutil * mv *)",
      "Bash(gsutil cp *)",
      "Bash(gsutil * cp *)",
      "Bash(gsutil rsync *)",
      "Bash(gsutil * rsync *)",
      "Bash(gsutil setmeta *)",
      "Bash(gsutil * setmeta *)",
      "Bash(gsutil acl *)",
      "Bash(gsutil * acl *)",
      "Bash(gsutil iam *)",
      "Bash(gsutil * iam *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-recursive-rm.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bell.sh"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh waiting"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bell.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh done"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh working"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh off"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh waiting"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh idle"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {},
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "formulae.brew.sh",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.local/state"
      ]
    },
    "excludedCommands": [
      "trash *",
      "gio trash *",
      "git push *",
      "git pull *",
      "git fetch *",
      "gh *",
      "brew *",
      "tmux *",
      "gcloud *",
      "bq *",
      "gsutil *",
      "kubectl *",
      "aws *"
    ]
  },
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
