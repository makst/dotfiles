{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "~/.codex/hooks/tmux-state.sh idle"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "~/.codex/hooks/tmux-state.sh working"}]}],
    "PreToolUse": [{"matcher": "^Bash$", "hooks": [{"type": "command", "command": "~/.codex/hooks/no-recursive-rm.sh"}]}],
    "PermissionRequest": [{"hooks": [
      {"type": "command", "command": "~/.codex/hooks/tmux-state.sh waiting codex"},
      {"type": "command", "command": "~/.codex/hooks/notify.sh Codex"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "~/.codex/hooks/tmux-state.sh working"}]}],
    "Stop": [{"hooks": [
      {"type": "command", "command": "~/.codex/hooks/answer.sh"},
      {"type": "command", "command": "~/.codex/hooks/bell.sh"},
      {"type": "command", "command": "~/.codex/hooks/tmux-state.sh done"}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "~/.codex/hooks/tmux-state.sh idle"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "~/.codex/hooks/tmux-state.sh off"}]}]
  }
}
