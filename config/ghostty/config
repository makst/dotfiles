# Ghostty config: https://ghostty.org/docs/config
# ~/.config/ghostty/config and ~/.config/ghostty/themes are symlinked here by setup_ghostty (zsh/.functions).
# Reload with cmd+shift+, ; list options with `ghostty +show-config --default --docs`.

# -- look -----------------------------------------------------------------------
# themes/base16 is the base16 scheme nvim uses (base16-onedark); `change_theme` switches both.
# Ghostty's own themes: `ghostty +list-themes`
theme = base16

# Source Code Pro 18, carried over from the old iTerm profile.
# Nerd Font icons (eza, starship, nvim) come from Ghostty's built-in symbol fallback.
font-family = Source Code Pro
font-size = 18
adjust-cell-height = 10%
# Nerd Font icons as tall as capitals and digits: by default they're a fifth taller (31 px against 25 at size
# 18 on a Retina screen), sticking out above the text and below its baseline, e.g. the agent marks in tmux's
# status bar. An icon with a space after it, as all of ours have, is sized against the font's full height
# (about 45 px here) and only shrinks once that's below the icon's own height. Measured: -24% left them at
# 31 px, -36% at 30, -45% at 26; -48% makes them 24, the digits' height. An icon right before other text
# would come out smaller.
adjust-icon-height = -48%
# Icons are centred on the font's whole box, descender included, which puts them above the middle of the
# digits and capitals; this moves the text up a pixel (icons stay where they are), so icons start and end
# where capitals do. 2 pixels put most icons a pixel below the baseline.
adjust-font-baseline = 1

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-padding-color = extend
macos-titlebar-style = tabs
window-save-state = always

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# -- input ------------------------------------------------------------------------
# Option acts as Alt, for vim / tmux / zsh bindings
macos-option-as-alt = true

# shell integration: zsh sets the cursor shape per vi mode itself (zsh/.zshdefault), so leave the cursor alone
# ssh-terminfo / ssh-env: remote hosts get Ghostty's terminfo, or fall back to xterm-256color (plain windows;
# inside tmux TERM is tmux-256color, see the ssh alias in zsh/.aliases)
shell-integration-features = no-cursor,sudo,title,ssh-terminfo,ssh-env

# Shift+Enter inserts a newline (Claude Code, multi-line prompts)
keybind = shift+enter=text:\x1b\r

# -- quick terminal ------------------------------------------------------------------
# drop-down terminal from anywhere: ctrl+` (needs Accessibility access for Ghostty)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# -- tmux -----------------------------------------------------------------------------
# A new window attaches to the tmux session "main" (created if needed) when no other window shows it, so
# sessions, agents and layouts survive quitting Ghostty; otherwise it's plain zsh. Decided per window, not
# for the first one only: a window that window-save-state restores out of sight must not keep tmux to
# itself. tmux starts through a login zsh so its server gets the full PATH (fzf, zoxide, claude for popups
# and plugins). zsh first in the command keeps Ghostty's zsh shell integration.
command = /opt/homebrew/bin/zsh -fc 'if /opt/homebrew/bin/tmux list-clients -t main 2>/dev/null | read -r; then exec /opt/homebrew/bin/zsh -l; else exec /opt/homebrew/bin/zsh -lic "exec tmux new-session -A -s main"; fi'

# Cmd shortcuts drive tmux: they send the prefix (C-a, \x01) and a key bound in config/tmux/tmux.conf.
# In a plain window (cmd+n, quick terminal) they type into the shell; close those with cmd+shift+w.
keybind = super+t=text:\x01c
keybind = super+d=text:\x01|
keybind = super+shift+d=text:\x01-
keybind = super+w=text:\x01x
keybind = super+[=text:\x01\x08
keybind = super+]=text:\x01\x0c
# no previous / next session: one shift away from previous / next window, the two got mixed up. Sessions are
# cmd+k, cmd+j and cmd+shift+0. Unbound so Ghostty's tab switching doesn't take the keys either.
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+shift+enter=text:\x01z
keybind = super+k=text:\x01f
keybind = super+j=text:\x01w
keybind = super+shift+j=text:\x01a
# the next Claude Code agent that needs you, cycling, as Space cycles panes and splits
keybind = super+shift+space=text:\x01A
keybind = super+f=text:\x01/
# rename the window / session (tmux defaults prefix , and prefix $)
keybind = super+r=text:\x01,
keybind = super+shift+r=text:\x01$
keybind = super+digit_1=text:\x011
keybind = super+1=text:\x011
keybind = super+digit_2=text:\x012
keybind = super+2=text:\x012
keybind = super+digit_3=text:\x013
keybind = super+3=text:\x013
keybind = super+digit_4=text:\x014
keybind = super+4=text:\x014
keybind = super+digit_5=text:\x015
keybind = super+5=text:\x015
keybind = super+digit_6=text:\x016
keybind = super+6=text:\x016
keybind = super+digit_7=text:\x017
keybind = super+7=text:\x017
keybind = super+digit_8=text:\x018
keybind = super+8=text:\x018
keybind = super+digit_9=text:\x019
keybind = super+9=text:\x019
# 0: back to the last one, as alt+0 in AeroSpace. cmd+0 the last window (tmux default prefix l, replacing
# Ghostty's reset_font_size), cmd+shift+0 the last session (prefix S), ctrl+0 the last pane (tmux default
# prefix ;)
keybind = super+shift+digit_0=text:\x01S
keybind = super+shift+0=text:\x01S
keybind = super+digit_0=text:\x01l
keybind = super+0=text:\x01l
keybind = ctrl+digit_0=text:\x01;
keybind = ctrl+0=text:\x01;
