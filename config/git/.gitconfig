# Linked to ~/.gitconfig by setup_git (zsh/functions/git.zsh). What differs per Mac (name, signing key, work
# email) is in ~/.config/dotfiles/gitconfig, included at the bottom.
[user]
	name = Max Tkatschenko
	email = makst@users.noreply.github.com

# Commits and tags are signed with an SSH key: each Mac's own Secretive signing key, which doesn't ask for
# Touch ID (see docs/git.md). `secretive_key signing` turns signing on for the Mac, in its
# ~/.config/dotfiles/gitconfig (user.signingkey, commit.gpgsign, tag.gpgsign); until then commits aren't
# signed instead of failing. GitHub shows them as Verified once the key is added there as a *signing* key
[gpg]
	format = ssh
[gpg "ssh"]
	# whose signatures `git log --show-signature` trusts
	allowedSignersFile = ~/dotfiles/config/git/allowed_signers
[commit]
	# the diff is shown below the message in the editor
	verbose = true

[alias]
	lca = log --pretty=format:'[%h] %cd - Committer: %cn (%ce), Author: %an (%ae)'

	# Switch to a branch, creating it if necessary
	go = "!f() { git switch \"$1\" 2> /dev/null || git switch -c \"$1\"; }; f"

	# Switch to new branch and set it to track the upstream branch
	get = "!f() { git checkout --track origin/\"$1\"; }; f"

	aliases = config --get-regexp alias

	# structural diffs (difftastic): compares syntax trees, so reformatting and re-wrapping aren't changes
	dft = -c diff.external=difft diff
	dlog = -c diff.external=difft log -p --ext-diff
	dshow = -c diff.external=difft show --ext-diff

[color]
	# Use colors in Git commands that are capable of colored output when
	# outputting to the terminal. (This is the default setting in Git ≥ 1.8.4.)
	ui = true

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = green
	changed = red
	untracked = white

[diff]
	# Detect copies as well as renames
	renames = copies
	# better hunks than the default myers
	algorithm = histogram
	# moved lines in their own colour
	colorMoved = default
	# `git difftool`: nvim's diff mode (a tool git knows, no cmd needed)
	tool = nvimdiff

[help]
	# Suggest the corrected command for a typo and ask before running it
	autocorrect = prompt

[merge]
	# Include summaries of merged commits in newly created merge commit messages
	log = true
	# conflict markers also show the common ancestor, minus the lines both sides share
	conflictstyle = zdiff3
	# `git mergetool`: nvim with local, base and remote above the merged file
	tool = nvimdiff

[core]
	pager = delta
	editor = nvim
	# a file-system watcher per repo (git's own daemon) and a cache of untracked files: `git status` stays fast
	# in big repos
	fsmonitor = true
	untrackedCache = true

[interactive]
	# `git add -p` hunks coloured by delta too
	diffFilter = delta --color-only

[delta]
	# n / N jump between files
	navigate = true
	line-numbers = true
	# the terminal's 16 colours, so it follows the Ghostty theme (like bat). delta's own defaults for changed
	# lines are fixed dark red / green backgrounds; here removed lines are red, added ones green, and the
	# changed words within them get a red / green background.
	syntax-theme = base16
	minus-style = red
	minus-emph-style = black red
	minus-empty-line-marker-style = normal red
	plus-style = green
	plus-emph-style = black green
	plus-empty-line-marker-style = normal green
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	line-numbers-zero-style = brightblack

[pull]
	# local commits go on top of the fetched ones instead of a merge commit (rebase.autoStash keeps
	# uncommitted changes)
	rebase = true

[push]
	# `git push` on a new branch creates it on origin and tracks it
	autoSetupRemote = true

[fetch]
	# drop local copies of branches deleted on the remote
	prune = true

[rebase]
	# stash before, pop after
	autoStash = true
	# stacked branches pointing into the rebased commits move with them
	updateRefs = true

[rerere]
	# remember how a conflict was resolved and replay it when the same conflict comes back
	enabled = true

[branch]
	# `git branch` lists recently committed-to branches first
	sort = -committerdate

[init]
	defaultBranch = main

# no credential helper for the user "git" on GitHub: tpm (and lazy.nvim) clone from https://git::@github.com/…
# so they never ask for a password, and git would save that empty login in the keychain after every clone
# (Homebrew git's osxkeychain helper), or ask macOS for a keychain where there is none. An empty helper
# clears the list; a real https login to GitHub, under another user, still goes to the keychain.
[credential "https://git@github.com"]
	helper =

# this Mac's own settings, e.g. the work email for work repos (setup_machine, config/machine/gitconfig).
# Last, so they win; git skips the file if it doesn't exist
[include]
	path = ~/.config/dotfiles/gitconfig
