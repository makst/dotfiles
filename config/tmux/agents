#!/usr/bin/env zsh
# Usage: agents [fzf options]
# The Claude Code agents in every session, most urgent first: waiting, done, working, then the idle ones and
# those without a state yet. Each line has the agent's mark, its window and what it's working on (Claude Code's
# title for the pane, without its leading ✳); the preview shows its screen. List and preview refresh every
# second, so states and order stay current while it's open; Enter switches there. Keys as in every picker
# (config/tmux/picker.zsh): it opens in normal mode, j/k move, / filters. Bound to prefix a (cmd+shift+j,
# config/tmux/tmux.conf); arguments go to fzf, e.g. --height=100% to fill the tmux popup.
# `agents --list` prints the lines alone, for fzf's reload.
source ${0:A:h}/picker.zsh

# each line is "pane id<tab>what fzf shows"; a sort key in front orders them by state, keeping tmux's order
# within one state
if [[ $1 == --list ]]; then
  typeset -A rank=(waiting 1 done 2 working 3)
  for line in ${(f)"$(tmux list-panes -a -f '#{&&:#{E:@claude-agent},#{?@listed,#{E:@listed},1}}' \
    -F '#{pane_id}'$'\t''#{@claude}'$'\t''#S:#I #W'$'\t''#{s/^✳ //:pane_title}')"}; do
    fields=("${(@ps:\t:)line}")
    print -r -- "${rank[$fields[2]]:-4}"$'\t'"$fields[1]"$'\t'"${picker_marks[$fields[2]]:- } $fields[3]  $fields[4]"
  done | sort -s -t $'\t' -k 1,1n | cut -f 2-
  exit 0
fi

self=${0:A}
choice=$("$self" --list | picker agent --live "$self --list" \
  --header 'j/k move · Enter switches · / filters, jj back · q quits · cmd+j for every window' \
  --preview "$picker_screen" --preview-window "$picker_preview,follow" --bind $picker_label "$@")
[[ -n $choice ]] && tmux switch-client -t "${choice%%$'\t'*}"
exit 0
