#!/usr/bin/env zsh
# Pick a tmux session: the running ones first, then directories from zoxide, which get a
# session of their own named after the directory. Bound to prefix f (config/tmux/tmux.conf)
# and to `tm` in zsh (zsh/.aliases); attaches when run outside tmux. Arguments go to fzf, e.g.
# --height=100% to fill the tmux popup. Sessions with Claude Code in them show their most urgent agent's
# mark, as the tree does (config/tmux/tmux.conf, "Claude Code agents"); the marks and the preview, a session's
# screen or a directory's files, stay current while it's open. Keys as in every picker (config/tmux/picker.zsh),
# but it opens ready to type: jj for j/k. `sessionizer --list` prints the lines alone, for fzf's reload.
source ${0:A:h}/picker.zsh

# each line is "key<tab>what fzf shows": a session's id (exact, unlike its name: tmux matches names by prefix)
# with its name and agent's mark in ANSI colours, or a directory's path, shown as ~/… when under $HOME
if [[ $1 == --list ]]; then
  for line in ${(f)"$(tmux list-sessions -F '#{session_id}'$'\t''#S'$'\t''#{E:@claude-session-state}' 2> /dev/null)"}; do
    fields=("${(@ps:\t:)line}")
    print -r -- "$fields[1]"$'\t'"$fields[2]${fields[3]:+ $picker_marks[$fields[3]]}"
  done
  for dir in ${(f)"$(zoxide query --list)"}; print -r -- "$dir"$'\t'"${dir/#$HOME/~}"
  exit 0
fi

self=${0:A}
choice=$("$self" --list | picker session --insert --live "$self --list" --reverse \
  --header 'type to filter, jj for j/k · Enter switches · Esc quits · sessions, then directories' \
  --preview "$picker_screen || eza -1 --color=always --icons=always --group-directories-first {1}" \
  --preview-window $picker_preview \
  --bind 'focus:transform-preview-label:case {1} in "\$"*) tmux display -p -t {1} " #S:#I #W " ;; *) printf " %s " {2} ;; esac' "$@")
[[ -z $choice ]] && exit 0
choice=${choice%%$'\t'*}

if [[ $choice == \$* ]]; then
  target=$choice
else
  target=${${choice:t}//[.:]/_} # tmux turns . and : in session names into _ anyway
  tmux has-session -t "=$target" 2> /dev/null || tmux new-session -d -s "$target" -c "$choice"
  target="=$target"
fi

if [[ -n $TMUX ]]; then
  tmux switch-client -t "$target"
else
  tmux attach-session -t "$target"
fi
