#!/usr/bin/env zsh
# Usage: tree [fzf options]
# Every session and window as a tree, drawn as tmux's own tree (choose-tree) draws it, with the panes of
# windows that have more than one. Each line has the agent mark of what's in it and what its agents work on;
# the preview shows the screen of the pane, or the active one of the window or session, and its label which
# window that is. List and preview refresh every second; Enter switches there. It opens on the current window.
# Keys as in every picker (config/tmux/picker.zsh): normal mode, j/k move, / filters. Bound to prefix w
# (cmd+j, config/tmux/tmux.conf); arguments go to fzf, e.g. --height=100% to fill the tmux popup.
# `tree --list` prints the lines alone, for fzf's reload.
source ${0:A:h}/picker.zsh

# each line is "key<tab>what fzf shows": the id of the session ($…), window (@…) or pane (%…), which
# switch-client and capture-pane take as they are. One line per pane from tmux, sessions and windows in order;
# a session's line comes before its first pane's, a window's too.
if [[ $1 == --list ]]; then
  title='#{s/^✳ //:pane_title}'
  rows=(${(f)"$(tmux list-panes -a -F "$(print -rl -- '#{session_id}' '#S' '#{session_windows}' \
    '#{?session_attached, (attached),}' '#{E:@claude-session-state}' '#{window_id}' '#I' '#W#{window_flags}' \
    '#{window_end_flag}' '#{window_panes}' '#{E:@claude-window-state}' "#{P:#{?#{E:@claude-agent}, $title,}}" \
    '#{pane_id}' '#P' '#{pane_current_command}#{?pane_active,*,}' '#{@claude}' "#{?#{E:@claude-agent}, $title,}" \
    | paste -sd $'\t' -)")"})
  session= window=
  for i in {1..$#rows}; do
    f=("${(@ps:\t:)rows[i]}")
    next=("${(@ps:\t:)rows[i+1]}")
    if [[ $f[1] != $session ]]; then
      session=$f[1]
      print -r -- "$f[1]"$'\t'"$f[2]: $f[3] windows$f[4]${f[5]:+ $picker_marks[$f[5]]}"
    fi
    # the tree's lines: ├─> for a window, └─> for the session's last; a pane's line continues its window's
    (( f[9] )) && branch='└─>' stem='    ' || branch='├─>' stem='│   '
    if [[ $f[6] != $window ]]; then
      window=$f[6]
      print -r -- "$f[6]"$'\t'"$branch $f[7]: $f[8]${f[11]:+ $picker_marks[$f[11]]}$f[12]"
    fi
    (( f[10] > 1 )) || continue
    [[ $next[6] == $f[6] ]] && twig='├─>' || twig='└─>'
    print -r -- "$f[13]"$'\t'"$stem$twig $f[14]: $f[15]${f[16]:+ $picker_marks[$f[16]]}$f[17]"
  done
  exit 0
fi

self=${0:A}
list=$("$self" --list)
# start on the current window: its line number among the keys
# (not $TMUX_PANE's: a popup inherits one from the environment tmux started in)
current=${${(f)list}[(i)$(env -u TMUX_PANE tmux display -p '#{window_id}')[[:blank:]]*]}
choice=$(print -r -- $list | picker tree --live "$self --list" --reverse --bind "load:pos($current)+unbind(load)" \
  --header 'j/k move · Enter switches · / filters, jj back · q quits · cmd+shift+j for the agents' \
  --preview "$picker_screen" --preview-window 'nohidden,down,60%,follow' \
  --bind 'focus:transform-preview-label:tmux display -p -t {1} " #S:#I #W "' "$@")
[[ -n $choice ]] && tmux switch-client -t "${choice%%$'\t'*}"
exit 0
