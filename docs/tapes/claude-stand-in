#!/usr/bin/env zsh
# claude-stand-in [--settings <json>] -w <name> [task]: what `claude` is in the GIFs (docs/tapes/demo-home
# puts it on PATH), since the real one needs a login, costs tokens, answers differently each time and shows
# the account. It does the part the GIF is about, the way Claude Code would: makes the worktree `claude -w`
# makes, adds a file, rings the bell when it needs an answer (as the Notification hook makes Claude Code
# do) and commits on the agent's branch. It says on screen that it's a stand-in.
local name task answer
while (( $# )); do
  case $1 in
    --settings) shift 2 ;;
    -w) name=$2; shift 2 ;;
    *) task=$1; shift ;;
  esac
done
local root=$(git rev-parse --show-toplevel) || exit 1
local worktree=$root/.claude/worktrees/$name
git -C $root worktree add -q -b $name $worktree || exit 1
cd $worktree

print -P "%F{magenta}✻%f %BClaude Code%b %F{8}(a stand-in for the GIF, see docs/gifs.md)%f"
print -P "%F{8}worktree .claude/worktrees/$name, branch $name%f\n"
print -r -- "> $task"
print
sleep 1.5
print -P "%F{green}●%f Read greet.ts"
sleep 1.5
local test='import { greet } from "./greet";

test("greet", () => {
  expect(greet("Ada")).toBe("Hello, Ada");
  expect(greet("Ada", true)).toBe("Hello, Ada!");
});'
print -r -- $test > greet.test.ts
print -P "%F{green}●%f Write greet.test.ts"
local line
for line in "${(@f)test}"; do
  print -P -- "  %F{green}+ ${line//\%/%%}%f"
done
print
sleep 1
print -n -P "%F{yellow}?%f Commit this on $name? (y/n) "
print -n '\a'
read -k1 answer
print
if [[ $answer == y ]]; then
  git add greet.test.ts
  git -c commit.gpgsign=false commit -q -m "test(greet): plain and excited greetings"
  print -P "%F{green}●%f Committed on $name"
fi
