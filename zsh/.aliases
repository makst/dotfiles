#!/usr/bin/env zsh

alias sn="spotify next"
alias sp="spotify prev"

# https://apple.stackexchange.com/a/110541
alias copy_last_cmd='fc -ln -1 | awk '\''{$1=$1}1'\'' ORS='\'''\'' | pbcopy'

alias lg='lazygit'

# tmux session picker: running sessions and zoxide directories (prefix f / cmd+k inside tmux)
alias tm='~/.config/tmux/sessionizer'
# remote hosts often lack tmux-256color's terminfo: inside tmux, ssh with a TERM every server knows
[[ -n $TMUX ]] && alias ssh='TERM=xterm-256color ssh'

alias docker="podman"

# eza instead of ls for the long listings: colours (LS_COLORS), git status, icons (Ghostty bundles the Nerd Font symbols)
alias ll='eza -l --git --group-directories-first --icons=auto'
alias la='eza -la --git --group-directories-first --icons=auto'
alias l='la'
alias lt='eza --tree --level=2 --git-ignore --icons=auto'

# kubectl; completion works through the aliases
alias k='kubectl'
alias kg='kubectl get'
alias kd='kubectl describe'
alias ka='kubectl apply -f'
alias krm='kubectl delete'
alias kgpo='kubectl get pods'
alias kdpo='kubectl describe pods'
alias kgns='kubectl get namespaces'
alias klo='kubectl logs -f'
alias kex='kubectl exec -it'
alias kpf='kubectl port-forward'
