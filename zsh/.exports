#!/usr/bin/env zsh

# Homebrew (native Apple silicon install): what `brew shellenv` prints, written out so a shell start doesn't
# run brew
if [[ -d /opt/homebrew ]]; then
  export HOMEBREW_PREFIX=/opt/homebrew HOMEBREW_CELLAR=/opt/homebrew/Cellar HOMEBREW_REPOSITORY=/opt/homebrew
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
  export INFOPATH=/opt/homebrew/share/info:${INFOPATH:-}
fi

# the pager is less, set here rather than left to each tool's default: delta (git's pager) and glow (mdv) hand
# their output to it; man has its own, MANPAGER below
export PAGER=less
# lesspipe: set LESSOPEN
cached_eval lesspipe.sh lesspipe.sh
# syntax highlighting
export LESS=' -R '
# bat: the base16 theme uses the terminal's 16 colours, i.e. the Ghostty theme
export BAT_THEME=base16
# _ls_colors: file colours for eza, fzf-tab and zsh completion; the ansi theme uses the terminal's 16
# colours, so it follows the Ghostty theme
_ls_colors() { print -r -- "export LS_COLORS=${(q)$(vivid generate ansi)}" }
cached_eval vivid _ls_colors
unfunction _ls_colors

export EDITOR=nvim
# man pages open in nvim (docs/design.md, "One tool per job"): its motions, search, `gO` for the sections,
# K on a word for that page, q to quit
export MANPAGER='nvim +Man!'
# python's REPL from 3.13 on is its own and ignores ~/.editrc; the basic one reads it, so it has vi mode
# (config/readline/editrc)
export PYTHON_BASIC_REPL=1

# ssh keys come from Secretive's agent (Secure Enclave keys, see config/ssh/config). git signs commits through
# SSH_AUTH_SOCK, not the ssh config, so it is set here too. A fixed path, so it doesn't go stale in tmux.
_secretive_socket=~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
[[ -S $_secretive_socket ]] && export SSH_AUTH_SOCK=$_secretive_socket
unset _secretive_socket

export PATH="$HOME/bin:$PATH"
# also where uv puts python, python3 and tools installed with `uv tool install`
export PATH="$HOME/.local/bin:$PATH"

# Android: the SDK that Android Studio installs, so adb, the emulator and Gradle work from the shell and nvim.
# Gradle needs a JDK; Android Studio's own is used unless JAVA_HOME is set already.
if [[ -d ~/Library/Android/sdk ]]; then
  export ANDROID_HOME=~/Library/Android/sdk
  path+=($ANDROID_HOME/platform-tools $ANDROID_HOME/emulator $ANDROID_HOME/cmdline-tools/latest/bin)
  _studio_jdk='/Applications/Android Studio.app/Contents/jbr/Contents/Home'
  [[ -z ${JAVA_HOME:-} && -d $_studio_jdk ]] && export JAVA_HOME=$_studio_jdk
  unset _studio_jdk
fi

# Google Cloud (gcloud-cli cask): bq and the components `gcloud components install` adds, like
# gke-gcloud-auth-plugin for kubectl, live here; brew links only gcloud, bq and gsutil
[[ -d /opt/homebrew/share/google-cloud-sdk/bin ]] && path+=(/opt/homebrew/share/google-cloud-sdk/bin)

# node versions come from fnm: the default one is on PATH, and it is the only node there (Homebrew's, which
# the language servers run on by its full path, is not linked: Brewfile). Not cached: it makes a link per
# shell. Its own --use-on-cd hook fails on a version that isn't installed and leaves the last node active
# without a word, so _node_use_pinned replaces it.
if command -v fnm > /dev/null; then
  eval "$(fnm env --version-file-strategy=recursive --resolve-engines --shell zsh)"
  # _node_use_pinned [fnm options]: chpwd hook, and once at start (a new pane can open inside a project), where
  # --log-level=error leaves out the "Using Node" line. Switches to the version that .nvmrc, .node-version or
  # package.json's engines pins here or above, installing it when it's missing; says so in red when that fails,
  # rather than going on with another node.
  function _node_use_pinned() {
    fnm "$@" use --install-if-missing --silent-if-unchanged ||
      print -u2 -P "%F{red}node: the version pinned for ${PWD/#$HOME/~} couldn't be used; still on $(node -v)%f"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook chpwd _node_use_pinned
  # at start only where something here or above can pin a version: fnm takes ~6 ms
  () {
    local dir=$PWD
    while [[ -n $dir ]]; do
      [[ -e $dir/.nvmrc || -e $dir/.node-version || -e $dir/package.json ]] &&
        { _node_use_pinned --log-level=error; return }
      dir=${dir%/*}
    done
  }
fi

# _docker_host: the socket podman's VM serves the Docker API on, for what talks to it directly rather than
# through the `docker` command (docker-compose, testcontainers); docs/podman.md. It sits in macOS's temp
# directory for this user, which getconf names even where TMPDIR is another (Claude Code's shell)
_docker_host() { print -r -- "export DOCKER_HOST=unix://$(getconf DARWIN_USER_TEMP_DIR)podman/podman-machine-default-api.sock" }
cached_eval podman _docker_host
unfunction _docker_host

# remove duplicates, and directories that no longer exist (left in an inherited PATH / FPATH, e.g. by a
# tmux server started from an older shell)
typeset -U path fpath
path=(${^path}(N-/))
fpath=(${^fpath}(N-/))
