#!/usr/bin/env zsh

# Homebrew (native Apple silicon install): sets PATH, MANPATH, HOMEBREW_PREFIX
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# lesspipe: set LESSOPEN
command -v lesspipe.sh > /dev/null && lesspipe.sh | source /dev/stdin
# syntax highlighting
export LESS=' -R '
# bat: the base16 theme uses the terminal's 16 colours, i.e. the Ghostty theme
export BAT_THEME=base16
# file colours for eza, fzf-tab and zsh completion
command -v vivid > /dev/null && export LS_COLORS="$(vivid generate one-dark)"

export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# node versions come from fnm: the default one is on PATH (also for nvim: mason, ts_ls), and cd into a
# directory with .nvmrc / .node-version switches to that version
command -v fnm > /dev/null && eval "$(fnm env --use-on-cd --version-file-strategy=recursive --resolve-engines --shell zsh)"

# Add pyenv executable to PATH and
# enable shims by adding the following
# to ~/.profile and ~/.zprofile:
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv > /dev/null; then
  eval "$(pyenv init --path)"

  # Load pyenv into the shell by adding
  # the following to ~/.zshrc:
  eval "$(pyenv init -)"
  # skip until `pyenv install 3.9.6` has been run, instead of erroring in every shell
  pyenv versions --bare | grep -qx 3.9.6 && pyenv global 3.9.6
fi

# remove duplicate in PATH
typeset -U PATH
