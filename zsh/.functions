#!/usr/bin/env zsh
real_script_dir="$(dirname "$(stat -f '%Y' ~/.zshrc)")"

timezsh() {
  shell=${1-$SHELL}
  for i in $(seq 1 10); do /usr/bin/time $shell -i -c exit; done
}

# change the nvim colorscheme (base16)
# the terminal theme is set in config/ghostty/config (see `ghostty +list-themes`)
function change_theme() {
  echo "vim.cmd [[colorscheme $(find ~/.local/share/nvim/lazy/base16-vim/colors/* -type f -exec basename {} .vim \; | fzf)]]" > ~/.config/nvim/lua/user/base16-vim.lua
}

# -------------------------
# CHEATSHEETS 
# -------------------------

# Takes ~15-20 min to sync the full catalog
function sync_cheatsh() {
  mkdir -p ~/cheatsheets/cheatsh/
  
  # get a list with all cheatsheets
  curl -s cheat.sh/:list --output ~/cheatsheets/cheatsh/list

  while IFS= read -r line; do
    chsh_req=$line
    file_name=$(echo "$line" | sed -E 's/[^[:alnum:][:space:]]/_/g')
    curl -s cheat.sh/$chsh_req --output ~/cheatsheets/cheatsh/$file_name
  done < ~/cheatsheets/cheatsh/list

  echo "Done syncing cheat.sh"
}

function sync_learnx_in_y_minutes() {
  mkdir -p ~/cheatsheets/learnxinyminutes/
}

function sync_cheatsheets() {
  sync_cheatsh
  sync_learnx_in_y_minutes
}

# -------------------------
# INSTALL / SETUP FUNCTIONS
# -------------------------

function install_and_update_zsh_plugins() {
  current_dir=$(pwd)

  [[ ! -d $ZSH_CUSTOM/plugins/zsh-syntax-highlighting ]] && git clone https://github.com/zsh-users/zsh-syntax-highlighting.git $ZSH_CUSTOM/plugins/zsh-syntax-highlighting
  cd $ZSH_CUSTOM/plugins/zsh-syntax-highlighting && git pull -q

  [[ ! -d $ZSH_CUSTOM/plugins/zsh-autosuggestions ]] && git clone https://github.com/zsh-users/zsh-autosuggestions.git $ZSH_CUSTOM/plugins/zsh-autosuggestions
  cd $ZSH_CUSTOM/plugins/zsh-autosuggestions && git pull -q

  [[ ! -d $ZSH_CUSTOM/plugins/zsh-vi-mode ]] && git clone https://github.com/jeffreytse/zsh-vi-mode $ZSH_CUSTOM/plugins/zsh-vi-mode
  cd $ZSH_CUSTOM/plugins/zsh-vi-mode && git pull -q

  [[ ! -d $ZSH_CUSTOM/plugins/zsh-nvm ]] && git clone https://github.com/lukechilds/zsh-nvm $ZSH_CUSTOM/plugins/zsh-nvm
  cd $ZSH_CUSTOM/plugins/zsh-nvm && git pull -q

  [[ ! -d $ZSH_CUSTOM/plugins/fzf-tab ]] && git clone https://github.com/Aloxaf/fzf-tab $ZSH_CUSTOM/plugins/fzf-tab
  cd $ZSH_CUSTOM/plugins/fzf-tab && git pull -q

  cd $current_dir
}

function rust_setup() {
  # rustup. -y: no prompts. --no-modify-path: ~/.cargo/bin is added to PATH by zsh/.exports,
  # the installer must not edit shell profiles (fails if e.g. ~/.bash_profile is owned by root)
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
  fi
  export PATH="$HOME/.cargo/bin:$PATH"
  rustup default stable

  # bob - nvim package manager
  command -v bob > /dev/null || cargo install --git https://github.com/MordechaiHadad/bob.git
  # bob puts the active nvim into ~/Library/Application Support/bob/nvim-bin (on PATH, see zsh/.exports)
  bob use stable
}

function brew_setup() {
  echo "=> Installing brew packages from the Brewfile"
  # see the Brewfile for what is installed and why
  brew bundle --file="$real_script_dir/Brewfile"
}

function setup_window_management() {
  # yabai and skhd are installed by the Brewfile.
  # yabai's scripting addition (`yabai --load-sa` in .yabairc) needs SIP partially disabled and,
  # on Apple silicon, the arm64e boot-arg: https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection

  # both tools install and start their own launch agent. They need Accessibility access
  # (System Settings > Privacy & Security > Accessibility) for yabai and skhd, then rerun this.
  yabai --start-service
  skhd --start-service

  ln -sfn "$real_script_dir/config/.yabairc" "$HOME/.yabairc"
  ln -sfn "$real_script_dir/config/.skhdrc" "$HOME/.skhdrc"
}

function fzf_setup() {
  # fzf, eza (improved file/directory listing), bat (cat with syntax highlighting) and
  # lesspipe (display more with less) come from the Brewfile
  ln -sfn "$real_script_dir/.fzf.zsh" "$HOME/.fzf.zsh"
}

function navi_data_dir_setup() {
  mkdir -p "$HOME/Library/Application Support/navi/cheats"
  ln -sfn "$real_script_dir/data_dir/navi/cheats" "$HOME/Library/Application Support/navi/cheats/makst_cheats"
}

function npm_setup() {
  # node comes from nvm (zsh-nvm plugin)
  nvm install --lts
  npm install -g \
    typescript 
}

function remap_keys() {
  # https://apple.stackexchange.com/a/283253
  # Caps Lock -> Right Ctrl
  local mapping='{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000e4}]}'
  hidutil property --set "$mapping"

  # hidutil mappings are lost on reboot, so re-apply it at every login
  local label="com.makst.capslock-to-ctrl"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>$mapping</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$label" 2> /dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
}

function setup_tmux() {
  ln -sfn "$real_script_dir/config/.tmux.conf" "$HOME/.tmux.conf"
}

function setup_ghostty() {
  mkdir -p "$HOME/.config/ghostty"
  ln -sfn "$real_script_dir/config/ghostty/config" "$HOME/.config/ghostty/config"
}

function setup_nvim() {
  ln -sfn "$real_script_dir/config/nvim" "$HOME/.config/nvim"
  mkdir -p "$HOME/bin"
  # a wrapper, not a symlink: bob's nvim is a proxy that picks the binary by the name it is called with.
  # Also works where aliases don't (git's core.editor = vim).
  rm -f "$HOME/bin/vim"
  printf '#!/bin/sh\nexec nvim "$@"\n' > "$HOME/bin/vim"
  chmod +x "$HOME/bin/vim"

  # plugins: lazy.nvim bootstraps itself on first start; install the versions pinned in
  # config/nvim/lazy-lock.json (needs network, cmake for telescope-fzf-native)
  command -v nvim > /dev/null && nvim --headless "+Lazy! restore" +qa
}

function setup_git() {
  ln -sfn "$real_script_dir/config/git/.gitconfig" "$HOME/.gitconfig"
}

# https://github.com/ccontavalli/ssh-ident
function install_ssh_ident() {
  if [[ ! -f ~/bin/ssh-ident ]]; then
    mkdir -p ~/bin
    curl -fsSL -o ~/bin/ssh-ident https://raw.githubusercontent.com/ccontavalli/ssh-ident/master/ssh-ident
    # upstream still says `#!/usr/bin/env python`, which macOS no longer provides
    sed -i '' '1s|.*|#!/usr/bin/env python3|' ~/bin/ssh-ident
    # python 3.15 rejects the 2 byte ioctl buffer, TIOCGPGRP needs room for a pid_t
    sed -i '' 's|fcntl.ioctl(fd, termios.TIOCGPGRP, "  ")|fcntl.ioctl(fd, termios.TIOCGPGRP, b"\\0" * 4)|' ~/bin/ssh-ident
    chmod 0755 ~/bin/ssh-ident
  fi

  ln -sfn ~/bin/ssh-ident ~/bin/ssh
  ln -sfn ~/bin/ssh-ident ~/bin/scp
  ln -sfn ~/bin/ssh-ident ~/bin/sftp
}

function setup_dotfiles() {
  brew_setup
  install_and_update_zsh_plugins
  rust_setup
  fzf_setup
  navi_data_dir_setup
  npm_setup
  install_ssh_ident
  setup_git
  setup_tmux
  setup_nvim
  setup_ghostty
  remap_keys
  # not run by default, needs SIP changes first: setup_window_management
}
