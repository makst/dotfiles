#!/usr/bin/env zsh

# shell start-up time; zsh-bench (https://github.com/romkatv/zsh-bench) measures input lag too
timezsh() {
  hyperfine --warmup 3 --shell=none "${1-$SHELL} -i -c exit"
}

# pick a base16 scheme for nvim and Ghostty (config/ghostty/themes/base16) together.
# tmux, fzf, bat and starship use the terminal's 16 colours, so they follow Ghostty.
function change_theme() {
  local colors=~/.local/share/nvim/lazy/tinted-vim/colors
  local scheme
  scheme=$(find "$colors" -name 'base16-*.vim' -exec basename {} .vim \; | sort | fzf --prompt 'base16 scheme> ') || return

  echo "vim.cmd [[colorscheme $scheme]]" > "$real_script_dir/config/nvim/lua/user/base16-vim.lua"

  # base16 -> ANSI the way tinted-terminal maps it
  awk -F"'" -v scheme="$scheme" '
    /^let s:gui0[0-9A-F] / { split($1, f, " "); c[substr(f[2], 6, 2)] = "#" $2 }
    END {
      print "# generated by change_theme (zsh/.functions) from tinted-vim " scheme
      print "background = " c["00"]; print "foreground = " c["05"]
      print "cursor-color = " c["05"]; print "cursor-text = " c["00"]
      print "selection-background = " c["02"]; print "selection-foreground = " c["05"]
      split("00 08 0B 0A 0D 0E 0C 05 03 08 0B 0A 0D 0E 0C 07", ansi, " ")
      for (i = 1; i <= 16; i++) print "palette = " i - 1 "=" c[ansi[i]]
    }' "$colors/$scheme.vim" > "$real_script_dir/config/ghostty/themes/base16"

  echo "=> $scheme: reload Ghostty with cmd+shift+, and restart nvim"
}

# -------------------------
# INSTALL / SETUP FUNCTIONS
# -------------------------

function brew_setup() {
  echo "=> Installing brew packages from the Brewfile"
  # see the Brewfile for what is installed and why
  brew bundle --file="$real_script_dir/Brewfile"
}

function setup_window_management() {
  # AeroSpace comes from the Brewfile. Its first start asks for Accessibility access (System Settings >
  # Privacy & Security > Accessibility); from then on it starts at login (start-at-login in the config).
  mkdir -p "$HOME/.config/aerospace"
  ln -sfn "$real_script_dir/config/aerospace/aerospace.toml" "$HOME/.config/aerospace/aerospace.toml"
  # Mission Control shows the windows of other workspaces too small without this
  defaults write com.apple.dock expose-group-apps -bool true && killall Dock
  # ctrl+cmd and drag anywhere in a window moves it; applies after logging out and in
  defaults write -g NSWindowShouldDragOnGesture -bool true
  open -a AeroSpace
}

function fzf_setup() {
  # fzf, eza (improved file/directory listing), bat (cat with syntax highlighting) and
  # lesspipe (display more with less) come from the Brewfile
  ln -sfn "$real_script_dir/.fzf.zsh" "$HOME/.fzf.zsh"
}

function npm_setup() {
  # node comes from fnm (Brewfile, zsh/.exports)
  fnm install --lts
  fnm default lts-latest
  npm install -g \
    typescript 
}

function remap_keys() {
  # https://apple.stackexchange.com/a/283253
  # Caps Lock -> Right Ctrl
  local mapping='{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000e4}]}'
  hidutil property --set "$mapping"

  # hidutil mappings are lost on reboot, so re-apply it at every login
  local label="com.makst.capslock-to-ctrl"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>$mapping</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$label" 2> /dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
}

function setup_atuin() {
  # atuin keeps its data and config in ~/.atuin
  mkdir -p ~/.atuin
  ln -sfn "$real_script_dir/config/atuin/config.toml" ~/.atuin/config.toml
  # once: copy the zsh history in, so C-r finds what was typed before atuin
  [[ -f ~/.atuin/data/history.db ]] || atuin import zsh
}

function setup_python() {
  # uv (Brewfile) installs python itself: `python` and `python3` in ~/.local/bin are the latest version.
  # Projects pin theirs with `uv python pin` / .python-version; `uv tool install` puts CLI tools on PATH.
  uv python install --default
}

function setup_macos_defaults() {
  # fast key repeat (the fastest System Settings offers), for held vim motions; applies after logging out and in
  defaults write -g KeyRepeat -int 2
  defaults write -g InitialKeyRepeat -int 15
  # a held key repeats in Ghostty instead of offering accented characters; restart Ghostty
  defaults write com.mitchellh.ghostty ApplePressAndHoldEnabled -bool false
}

# Touch ID for sudo, also inside tmux (pam-reattach from the Brewfile). Uses sudo itself, so it isn't part of
# setup_dotfiles. /etc/pam.d/sudo_local survives macOS updates, unlike /etc/pam.d/sudo.
function setup_touch_id_sudo() {
  printf '%s\n' \
    "auth       optional       $HOMEBREW_PREFIX/lib/pam/pam_reattach.so ignore_ssh" \
    "auth       sufficient     pam_tid.so" | sudo tee /etc/pam.d/sudo_local > /dev/null
}

function setup_tmux() {
  mkdir -p "$HOME/.config"
  ln -sfn "$real_script_dir/config/tmux" "$HOME/.config/tmux"
  # the config used to live in ~/.tmux.conf, which tmux would still prefer
  [[ -L ~/.tmux.conf ]] && rm ~/.tmux.conf

  # plugin manager; the plugins themselves are listed in config/tmux/tmux.conf
  [[ ! -d ~/.tmux/plugins/tpm ]] && git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
  ~/.tmux/plugins/tpm/bin/install_plugins
}

# make_gifs [tape…]: render the GIFs in docs/img from the VHS tapes in docs/tapes (all of them, or the ones
# named, e.g. `make_gifs tmux-panes`). Each tape runs in the real tmux config with the Ghostty theme and font,
# in a separate tmux server (docs/tapes/demo.tmux.conf) and a made-up HOME (docs/tapes/demo-home), and
# docs/tapes/keycast shows the keys pressed under the status bar. Rerun after changing a binding or the theme,
# and commit the GIFs.
function make_gifs() {
  local repo=$real_script_dir tmp tape name
  (( $+commands[vhs] )) || { print -u2 "make_gifs needs vhs (Brewfile)"; return 1 }
  # resolved, since mktemp's path runs through the /var symlink; programs that show paths relative to HOME
  # (Claude Code's header) would show the long resolved one instead of ~/…
  tmp=$(mktemp -d) && tmp=${tmp:A} || return

  # the Ghostty theme as a VHS theme
  local -A c
  local key value
  while IFS=' =' read -r key value; do
    [[ $key == palette ]] && key=${value%%=*} value=${value#*=}
    c[$key]=$value
  done < <(grep -v '^#' $repo/config/ghostty/themes/base16)
  local -a names=(black red green yellow blue magenta cyan white)
  local theme="{\"name\":\"base16\",\"background\":\"$c[background]\",\"foreground\":\"$c[foreground]\""
  theme+=",\"cursor\":\"$c[cursor-color]\",\"selection\":\"$c[selection-background]\""
  local i
  for i in {1..8}; do
    theme+=",\"$names[i]\":\"$c[$((i - 1))]\",\"bright${(C)names[i]}\":\"$c[$((i + 7))]\""
  done
  theme+='}'

  local -a tapes=(${@:+$repo/docs/tapes/${^@}.tape})
  (( $#tapes )) || tapes=($repo/docs/tapes/*.tape(N))
  for tape in $tapes; do
    name=${tape:t:r}
    print -P "%F{blue}=> $name%f"
    tmux -L demo kill-server 2> /dev/null
    # a fresh HOME per tape, so one tape's history or changes don't show up in the next
    $repo/docs/tapes/demo-home $tmp/$name $repo || return
    {
      print -r -- 'Set Shell zsh'
      print -r -- 'Set FontFamily "Source Code Pro, Symbols Nerd Font Mono"'
      print -r -- 'Set FontSize 18'
      print -r -- 'Set Width 1200'
      print -r -- 'Set Height 640'
      print -r -- 'Set Padding 16'
      print -r -- 'Set TypingSpeed 80ms'
      print -r -- "Set Theme $theme"
      print -r -- 'Hide'
      print -r -- "Type \"cd ${(q)repo} && HOME=$tmp/$name docs/tapes/keycast demo config/ghostty/config tmux -L demo -f docs/tapes/demo.tmux.conf new -s main -c $tmp/$name/dotfiles\" Enter"
      # the first start in a new HOME sets up the prompt and plugins' caches
      print -r -- 'Wait+Screen@30s /❯/'
      # a first command lets tmux name the window after the shell; the caption for its Enter is cleared
      print -r -- "Type \" clear; tmux set -g @keys ''\" Enter"
      print -r -- 'Sleep 1s'
      print -r -- 'Show'
      cat $tape
    } > $tmp/$name.tape
    (cd $repo && vhs $tmp/$name.tape) || { tmux -L demo kill-server 2> /dev/null; return 1 }
    tmux -L demo kill-server 2> /dev/null
  done
  trash $tmp
}

# Claude Code with this Mac's settings on top of the shared config/claude/settings.json, passed with --settings
# so they never land in the repo:
# - this shell's SSH agent socket is allowed in the sandbox, so commits get signed there (git signs through
#   SSH_AUTH_SOCK, which zsh/.exports points at Secretive; the path differs per machine)
# - ~/.config/dotfiles/claude.json (setup_machine): plugins, marketplaces and anything else only this Mac uses
# Afterwards it warns if Claude Code wrote plugins into the shared settings.json, which installing a plugin
# for the user does.
function claude() {
  local machine=~/.config/dotfiles/claude.json settings='{}'
  [[ -S $SSH_AUTH_SOCK ]] &&
    settings=$(jq -nc --arg sock $SSH_AUTH_SOCK '{sandbox: {network: {allowUnixSockets: [$sock]}}}')
  if [[ -r $machine ]]; then
    local merged
    merged=$(jq -c --argjson base $settings '$base * .' $machine) && settings=$merged ||
      print -u2 "$machine isn't valid JSON, starting without it"
  fi
  command claude --settings "$settings" "$@"
  local exit_code=$?
  claude_plugins_check
  return $exit_code
}

# claude_plugins_check: warn when the shared config/claude/settings.json has plugins or marketplaces that
# aren't committed. Installing a plugin "for you" writes it there, through the ~/.claude link, and from there
# it would reach every Mac with the next commit.
function claude_plugins_check() {
  local filter='[.enabledPlugins // {}, .extraKnownMarketplaces // {}]'
  local now=$(jq -cS $filter $real_script_dir/config/claude/settings.json 2> /dev/null)
  local committed=$(git -C $real_script_dir show HEAD:config/claude/settings.json 2> /dev/null | jq -cS $filter)
  [[ $now == $committed ]] && return 0
  print -u2 "Claude Code added plugins to the shared config/claude/settings.json (see git diff). Move them to" \
    "~/.config/dotfiles/claude.json for this Mac only, or to a project's .claude/settings.local.json;" \
    "commit only what every Mac should get."
  return 1
}

# Claude Code in its own git worktree (claude -w) and, inside
# tmux, in a new window named after the task. The window stays a shell once Claude exits.
#   agent fix-login
#   agent fix-login "the login form rejects valid emails"
function agent() {
  local name=${1:?usage: agent <name> [claude args...]}
  shift
  if [[ -z $TMUX ]]; then
    claude -w "$name" "$@"
    return
  fi
  local pane
  pane=$(tmux new-window -P -F '#{pane_id}' -n "$name" -c "$PWD") || return
  tmux send-keys -t "$pane" "claude -w ${(q)name}${@:+ ${(j: :)${(q)@}}}" Enter
}

# agent_done [--force] [name]: finish an agent started with `agent`. Without a name, lists the repo's agent
# worktrees: their branch, whether it's merged and whether there are uncommitted changes. With one, removes the
# worktree, deletes its branch and closes its tmux window, but only if nothing would be lost: no uncommitted
# changes and the branch merged into the default branch. --force deletes an unmerged branch too (uncommitted
# changes still stop it).
function agent_done() {
  local force=0
  [[ $1 == --force ]] && { force=1; shift }
  local main=${"$(git worktree list --porcelain 2> /dev/null | head -1)"#worktree }
  [[ -n $main ]] || { print -u2 "not in a git repo"; return 1 }
  local root=$main/.claude/worktrees
  local default=${"$(git -C $main symbolic-ref --short refs/remotes/origin/HEAD 2> /dev/null)"#origin/}
  [[ -n $default ]] || default=$(git -C $main rev-parse --abbrev-ref HEAD)

  if [[ -z $1 ]]; then
    local wt branch tip state
    for wt in $root/*(N/); do
      branch=$(git -C $wt branch --show-current) tip=$(git -C $wt rev-parse HEAD)
      if git -C $main merge-base --is-ancestor $tip $default; then state="merged"
      else
        local ahead=$(git -C $main rev-list --count $default..$tip)
        state="$ahead commit${${ahead:#1}:+s} not in $default"
      fi
      [[ -n $(git -C $wt status --porcelain) ]] && state+=", uncommitted changes"
      print "${wt:t}  ($branch: $state)"
    done
    return
  fi

  local name=$1 wt=$root/$1
  [[ -d $wt ]] || { print -u2 "no agent worktree $wt"; return 1 }
  local branch=$(git -C $wt branch --show-current) tip=$(git -C $wt rev-parse HEAD)
  if [[ -n $(git -C $wt status --porcelain) ]]; then
    print -u2 "$name has uncommitted changes; commit or discard them first:"
    git -C $wt status --short >&2
    return 1
  fi
  if ! git -C $main merge-base --is-ancestor $tip $default && (( ! force )); then
    print -u2 "${branch:-$name} isn't merged into $default; merge it, or agent_done --force $name to drop it:"
    git -C $main log --oneline $default..$tip >&2
    return 1
  fi

  # the window `agent` opened, unless it's the one running this. It goes first: closing it ends Claude Code,
  # which locks its worktree for as long as it runs
  if [[ -n $TMUX ]]; then
    local window=$(tmux list-windows -F '#{window_id} #{window_name}' | awk -v n=$name '$2 == n { print $1; exit }')
    [[ -n $window && $window != $(tmux display-message -p '#{window_id}') ]] && tmux kill-window -t $window
  fi
  # wait up to 2 s for Claude to unlock; a lock whose Claude no longer runs (pid in the reason) is lifted
  local lock i
  for i in {1..20}; do
    lock=$(git -C $main worktree list --porcelain | awk -v wt=$wt '
      $1 == "worktree" { here = ($2 == wt) } here && $1 == "locked" { print; exit }')
    [[ -z $lock ]] && break
    sleep 0.1
  done
  if [[ -n $lock ]]; then
    local pid=${${lock#*pid }%% *}
    if [[ $pid == <-> ]] && kill -0 $pid 2> /dev/null; then
      print -u2 "$name is still locked by a running Claude Code (pid $pid); quit it first"
      return 1
    fi
    git -C $main worktree unlock $wt
  fi

  [[ $PWD == $wt(|/*) ]] && cd $main
  git -C $main worktree remove $wt || return
  [[ -n $branch ]] && git -C $main branch -D $branch
  return 0
}

function setup_claude() {
  mkdir -p ~/.claude
  local item
  for item in settings.json CLAUDE.md hooks statusline.sh; do
    # a copy Claude Code made itself goes to the Trash; the repo's version replaces it
    [[ -e ~/.claude/$item && ! -L ~/.claude/$item ]] && mv ~/.claude/$item ~/.Trash/claude-$item-$(date +%s)
    ln -sfn "$real_script_dir/config/claude/$item" ~/.claude/$item
  done
}

function setup_ghostty() {
  mkdir -p "$HOME/.config/ghostty"
  ln -sfn "$real_script_dir/config/ghostty/config" "$HOME/.config/ghostty/config"
  ln -sfn "$real_script_dir/config/ghostty/themes" "$HOME/.config/ghostty/themes"
}

function setup_nvim() {
  ln -sfn "$real_script_dir/config/nvim" "$HOME/.config/nvim"
  mkdir -p "$HOME/bin"
  # `vim` runs nvim, also where aliases don't (git's core.editor = vim)
  ln -sfn /opt/homebrew/bin/nvim "$HOME/bin/vim"

  # plugins: lazy.nvim bootstraps itself on first start; install the versions pinned in
  # config/nvim/lazy-lock.json (needs network, cmake for telescope-fzf-native)
  command -v nvim > /dev/null && nvim --headless "+Lazy! restore" +qa
}

function setup_git() {
  ln -sfn "$real_script_dir/config/git/.gitconfig" "$HOME/.gitconfig"
  mkdir -p "$HOME/.config/git"
  ln -sfn "$real_script_dir/config/git/ignore" "$HOME/.config/git/ignore"
}

function setup_ssh() {
  mkdir -p ~/.ssh && chmod 700 ~/.ssh
  touch ~/.ssh/config

  # shared settings (keychain, agent, which key for which host) come from the repo
  local include="Include ~/dotfiles/config/ssh/config"
  if ! grep -qxF "$include" ~/.ssh/config; then
    { print -r -- "$include"; print; cat ~/.ssh/config } > ~/.ssh/config.new && mv ~/.ssh/config.new ~/.ssh/config
  fi

  # ssh-ident used to stand in for ssh, scp and sftp
  local tool
  for tool in ssh scp sftp; do
    [[ ${$(readlink ~/bin/$tool 2> /dev/null):t} == ssh-ident ]] && rm ~/bin/$tool
  done

  # the keys are in Secretive now (config/ssh/config), so the login item that loaded keychain keys into macOS's
  # own agent goes
  local label="com.makst.ssh-add" plist="$HOME/Library/LaunchAgents/com.makst.ssh-add.plist"
  if [[ -e $plist ]]; then
    launchctl bootout "gui/$(id -u)/$label" 2> /dev/null
    rm $plist
  fi
}

# secretive_key <push|signing> [name]: use the Secretive key called <name> (default: the role) as the push or
# the signing key. Make the key in the Secretive app first: push with "Require Authentication" (Touch ID for
# every ssh connection: push, pull, fetch), signing without it (commits and rebases don't ask). Copies its
# public key to ~/.ssh/identities/secretive/<role>.pub, which config/ssh/config and config/git/.gitconfig use,
# and adds it to GitHub: push as an ssh key (also copied for the GitLab page that opens), signing as a
# signing key and to config/git/allowed_signers.
function secretive_key() {
  local role=${1:?usage: secretive_key <push|signing> [name in Secretive]} name=${2:-$1}
  [[ $role == (push|signing) ]] || { print -u2 "the role is push or signing"; return 1 }

  # Secretive keeps each public key in a file named after its hash; find the one whose comment has the name
  local dir=~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys pub
  local -a found words
  for pub in $dir/*.pub(N); do
    words=(${=$(<$pub)})
    [[ ${(L)${(j:-:)words[3,-1]}} == *${(L)name// /-}* ]] && found+=$pub
  done
  if (( $#found != 1 )); then
    print -u2 "${#found} Secretive keys match '$name'; pass the name as the second argument. Keys:"
    for pub in $dir/*.pub(N); do words=(${=$(<$pub)}); print -u2 "  ${words[3,-1]}"; done
    return 1
  fi

  # GitHub lists the key under this Mac's name (setup_machine)
  local machine=${HOST%%.*}
  [[ -r ~/.config/dotfiles/name ]] && machine=$(<~/.config/dotfiles/name)
  local key=~/.ssh/identities/secretive/$role.pub title="$machine (Secretive)"
  mkdir -p ${key:h} && chmod 700 ${key:h}
  cp $found[1] $key || return
  words=(${=$(<$key)})

  # adding ssh keys needs one more permission than gh asks for at login
  gh auth status 2>&1 | grep -q admin:public_key || gh auth refresh -h github.com -s admin:public_key || return
  case $role in
    push)
      gh ssh-key add $key --type authentication --title $title || return
      pbcopy < $key
      open https://gitlab.com/-/user_settings/ssh_keys
      print "public key copied, paste it on the GitLab page that opened"
      ;;
    signing)
      gh ssh-key add $key --type signing --title $title || return
      # the Mac's name after the key, so retire_mac finds it
      local signer="$(git config user.email) namespaces=\"git\" ${words[1]} ${words[2]} $machine"
      local signers=$real_script_dir/config/git/allowed_signers
      grep -qF -- ${words[2]} $signers || print -r -- $signer >> $signers
      # sign from now on, on this Mac only (config/git/.gitconfig includes this file)
      local machine_git=~/.config/dotfiles/gitconfig
      git config --file $machine_git user.signingkey ${key/#$HOME/\~}
      git config --file $machine_git commit.gpgsign true
      git config --file $machine_git tag.gpgsign true
      ;;
  esac
}

# _github_keys [name]: the GitHub account's ssh keys as "<push|signing> <id> <title>" lines, only those whose
# title is the Mac's name or starts with it (secretive_key titles them "<name> (Secretive)"), any case.
function _github_keys() {
  local name=${(L)1} kind endpoint
  for kind endpoint in push user/keys signing user/ssh_signing_keys; do
    gh api $endpoint | jq -r --arg kind $kind --arg n "$name" '.[]
      | select($n == "" or (.title | ascii_downcase) == $n or (.title | ascii_downcase | startswith($n + " ")))
      | "\($kind) \(.id) \(.title)"' || return
  done
}

# mac_keys: every Mac's keys in one list: the push and signing keys on GitHub, by title, and the signing keys
# config/git/allowed_signers trusts, with the Mac's name and, for a retired one, when it stopped.
function mac_keys() {
  print "On GitHub:"
  _github_keys | sed 's/^/  /' || return
  print "\nIn config/git/allowed_signers:"
  local line
  local -a words
  for line in "${(@f)$(<$real_script_dir/config/git/allowed_signers)}"; do
    [[ $line == (\#*|) ]] && continue
    words=(${=line})
    print -r -- "  ${words[3]} ${${words[5,-1]}:-(no name)}${${(M)words[2]:#*valid-before=*}:+, retired before ${${words[2]##*valid-before=}//\"}}"
  done
}

# retire_mac <name>: stop trusting a Mac that is sold, wiped, handed back or lost; run it on another Mac. After
# asking, deletes the GitHub keys titled with its name and marks its line in config/git/allowed_signers
# valid-before this moment instead of deleting it, so the commits it signed until now still verify and
# anything signed with its key later doesn't. Lists what's left to do by hand: GitLab, servers, committing.
function retire_mac() {
  local name=${1:?usage: retire_mac <name of the Mac, as mac_keys shows it>}
  local signers=$real_script_dir/config/git/allowed_signers now=$(date +%Y%m%d%H%M%S) line kind id title endpoint
  local -a github words lines
  github=(${(f)"$(_github_keys $name)"}) || return

  # its signing keys: named after it in allowed_signers, or uploaded to GitHub under its name
  local -a signing_keys=(${(f)"$(gh api user/ssh_signing_keys |
    jq -r --arg n "${(L)name}" '.[] | select((.title | ascii_downcase) == $n or (.title | ascii_downcase |
    startswith($n + " "))) | .key | split(" ")[1]')"})
  local -i marked=0
  for line in "${(@f)$(<$signers)}"; do
    words=(${=line})
    if [[ $line != \#* && $words[2] != *valid-before=* ]] &&
      [[ ${(L)${(j: :)words[5,-1]}} == ${(L)name}(| *) || -n ${(M)signing_keys:#$words[4]} ]]; then
      words[2]+=",valid-before=\"$now\""
      line=${(j: :)words}
      marked+=1
    fi
    lines+=$line
  done

  if (( !$#github && !marked )); then
    print -u2 "no keys found for '$name'; mac_keys lists the names"
    return 1
  fi
  print "Retiring $name:"
  for line in $github; do print -r -- "  delete on GitHub: $line"; done
  (( marked )) && print "  mark $marked key(s) in config/git/allowed_signers valid-before=$now"
  read -q "?Go ahead? [y/N] " || { print; return 1 }
  print

  gh auth status 2>&1 | grep -q admin:ssh_signing_key ||
    gh auth refresh -h github.com -s admin:public_key,admin:ssh_signing_key || return
  for line in $github; do
    words=(${=line})
    kind=$words[1] id=$words[2] title=${words[3,-1]}
    endpoint=user/keys
    [[ $kind == signing ]] && endpoint=user/ssh_signing_keys
    gh api -X DELETE $endpoint/$id && print -r -- "deleted $kind key: $title"
  done
  (( marked )) && print -rl -- $lines > $signers

  print "\nLeft to do by hand:"
  (( marked )) && print "  - commit config/git/allowed_signers"
  print "  - GitLab: delete its key on https://gitlab.com/-/user_settings/ssh_keys"
  print "  - servers: remove its key from ~/.ssh/authorized_keys"
  print "  - tokens only that Mac had (cloud CLIs, API keys made for it): revoke them where they were made"
}

# setup_machine [<name> <home|work>]: this Mac's own settings, kept out of the repo in ~/.config/dotfiles. Asks
# the first time for its name (used for its keys on GitHub) and whether it's home-like or work-like (the
# Brewfile can install packages for one kind only); then creates the files git, zsh, brew and Claude Code load
# from there, from config/machine, leaving existing ones alone. Also points ~/dotfiles at this clone, wherever
# it is, since ~/.ssh/config and ~/.gitconfig use that path.
function setup_machine() {
  local dir=~/.config/dotfiles name=$1 kind=$2 file
  if [[ -e ~/dotfiles && ! -L ~/dotfiles && ! ~/dotfiles -ef $real_script_dir ]]; then
    print -u2 "~/dotfiles exists and isn't this repo ($real_script_dir); move it away and rerun"
  else
    [[ ~/dotfiles -ef $real_script_dir ]] || ln -sfn $real_script_dir ~/dotfiles
  fi

  mkdir -p $dir
  [[ -z $name && -r $dir/name ]] && name=$(<$dir/name)
  [[ -z $kind && -r $dir/kind ]] && kind=$(<$dir/kind)
  local suggested=${(L)${HOST%%.*}}
  until [[ -n $name && $name != *[^[:alnum:]_-]* ]]; do
    read -r "name?Name for this Mac (letters, digits, - and _; shown with its keys on GitHub) [$suggested]: " ||
      return 1
    name=${name:-$suggested}
  done
  until [[ $kind == (home|work) ]]; do
    print "Is it home-like or work-like? Every Mac gets all the shared apps; the kind only adds what the"
    read -r "kind?Brewfile marks for home or for work [home/work]: " || return 1
  done
  print -r -- $name > $dir/name
  print -r -- $kind > $dir/kind

  for file in $real_script_dir/config/machine/*(N); do
    [[ -e $dir/${file:t} ]] || cp $file $dir/
  done

  [[ $(git config --file $dir/gitconfig commit.gpgsign) == true ]] ||
    print "Commits on this Mac aren't signed until its Secretive keys exist: see 'A new Mac' in docs/setup.md."
  return 0
}

# setup_dotfiles: the whole setup, idempotent; rerun after every `git pull`. A step that fails doesn't stop the
# others (on a managed work Mac, MDM may block one, or an app may already be installed outside Homebrew); the
# failed ones are listed at the end, to fix and run again on their own.
function setup_dotfiles() {
  # everything below needs the Mac's name and kind
  setup_machine || return
  local step
  local -a failed
  for step in brew_setup fzf_setup setup_atuin npm_setup setup_python setup_ssh \
    setup_git setup_tmux setup_nvim setup_ghostty setup_claude remap_keys setup_macos_defaults \
    setup_window_management; do
    print -P "%F{blue}=> $step%f"
    $step || failed+=$step
  done
  if (( $#failed )); then
    print -u2 -P "%F{red}Failed: ${(j:, :)failed}.%f Fix the cause (see the output above) and run each again."
    return 1
  fi
}
