#!/usr/bin/env zsh

export ZSH_DISABLE_COMPFIX=true
export ZSH="$HOME/.oh-my-zsh"
export CLICOLOR=1
# no Oh My Zsh theme: the prompt is starship (config/starship.toml), started at the end of this file
ZSH_THEME=""
ZVM_VI_INSERT_ESCAPE_BINDKEY=jj

# https://github.com/jeffreytse/zsh-vi-mode/issues/15
function zvm_fix_partial_history_search() {
  zvm_bindkey viins '^[[A' history-beginning-search-backward
  zvm_bindkey viins '^[[B' history-beginning-search-forward

  zvm_bindkey vicmd '^[[A' history-beginning-search-backward
  zvm_bindkey vicmd '^k' history-beginning-search-backward
  zvm_bindkey vicmd '^[[B' history-beginning-search-forward
  zvm_bindkey vicmd '^j' history-beginning-search-forward
}

function zvm_before_init() {
  zvm_fix_partial_history_search
}

# The plugin will auto execute this zvm_after_init function.
# zsh-vi-mode resets the key bindings when it starts, so widgets that bind keys (fzf, navi) are loaded here.
function zvm_after_init() {
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
  eval "$(navi widget zsh)"
}

plugins=(
  git
  z
  zsh-syntax-highlighting
  fzf-tab
  zsh-autosuggestions
  zsh-vi-mode
)

source $ZSH/oh-my-zsh.sh

export STARSHIP_CONFIG="$real_script_dir/config/starship.toml"
command -v starship > /dev/null && eval "$(starship init zsh)"
