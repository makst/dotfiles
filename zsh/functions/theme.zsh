#!/usr/bin/env zsh
# Shell functions for the base16 colour scheme (docs/theme.md). Sourced by .zshrc with the rest of
# zsh/functions/*.zsh; each function's comment says what it does.

# change_theme [dark|light]: pick the base16 scheme for macOS's dark or light mode, for nvim and Ghostty
# together; without an argument, for the mode macOS is in now, so it changes what you're looking at.
# Ghostty switches between config/ghostty/themes/base16-dark and base16-light by itself, nvim between the two
# names in config/nvim/lua/user/base16-vim/schemes.lua; tmux, fzf, bat and starship use the terminal's 16
# colours, so they follow Ghostty. The list is the picker's (config/tmux/picker.zsh), ready to type in: there
# are a few hundred schemes. Ghostty's theme is written next to the live one and checked before it replaces
# it, so a scheme file it can't read, or a dark scheme picked for light mode (nvim tells the modes apart by
# the background's brightness), changes nothing.
function change_theme() {
  local mode=$1
  if [[ -z $mode ]]; then
    [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null) == Dark ]] && mode=dark || mode=light
  fi
  if [[ $mode != (dark|light) ]]; then
    print -u2 "usage: change_theme [dark|light]"
    return 2
  fi
  local colors=~/.local/share/nvim/lazy/tinted-vim/colors
  local themes=$real_script_dir/config/ghostty/themes
  local theme=$themes/base16-$mode
  local schemes_file=$real_script_dir/config/nvim/lua/user/base16-vim/schemes.lua
  local scheme
  source $_fzf_picker
  # the best match first, as it's a name you type; the list shows it without the base16- in front
  scheme=$(print -rl -- $colors/base16-*.vim(N:t:r) | awk '{ print $0 "\t" substr($0, 8) }' |
    picker "$mode scheme" --insert --sort \
      --header "the scheme for $mode mode · type to filter, jj for j/k · Enter picks · Esc quits") || return
  scheme=${scheme%%$'\t'*}

  # base16 -> ANSI the way tinted-terminal maps it
  awk -F"'" -v scheme="$scheme" -v mode="$mode" '
    /^let s:gui0[0-9A-F] / { split($1, f, " "); c[substr(f[2], 6, 2)] = "#" $2 }
    END {
      print "# generated by change_theme (zsh/functions/theme.zsh) from tinted-vim " scheme ", for " mode " mode"
      print "background = " c["00"]; print "foreground = " c["05"]
      print "cursor-color = " c["05"]; print "cursor-text = " c["00"]
      print "selection-background = " c["02"]; print "selection-foreground = " c["05"]
      split("00 08 0B 0A 0D 0E 0C 05 03 08 0B 0A 0D 0E 0C 07", ansi, " ")
      for (i = 1; i <= 16; i++) print "palette = " i - 1 "=" c[ansi[i]]
    }' "$colors/$scheme.vim" > $theme.new
  # 22 colours, each a # and six hex digits, or the scheme's file isn't what this reads
  if (( $(grep -cE '= ([0-9]+=)?#[0-9A-Fa-f]{6}$' $theme.new) != 22 )); then
    print -u2 "couldn't read the colours of $colors/$scheme.vim; the theme stays as it was"
    command rm -f $theme.new
    return 1
  fi
  # dark or light the way nvim decides it (luma of the background, below half is dark)
  local bg=$(grep -m1 '^background = ' $theme.new)
  bg=${bg##*'#'}
  local luma=$(( (299 * 16#${bg[1,2]} + 587 * 16#${bg[3,4]} + 114 * 16#${bg[5,6]}) / 255 ))
  local kind=light
  (( luma < 500 )) && kind=dark
  if [[ $kind != $mode ]]; then
    print -u2 "$scheme has a $kind background, not one for $mode mode; the theme stays as it was"
    command rm -f $theme.new
    return 1
  fi
  mv $theme.new $theme

  # schemes.lua keeps the other mode's scheme
  local -A schemes
  local line
  for line in "${(@f)$(<$schemes_file)}"; do
    [[ $line =~ "^  (dark|light) = '(.*)',$" ]] && schemes[$match[1]]=$match[2]
  done
  schemes[$mode]=$scheme
  print -rl -- "-- written by change_theme (zsh/functions/theme.zsh): the scheme for each macOS appearance" \
    "return {" "  dark = '$schemes[dark]'," "  light = '$schemes[light]'," "}" > $schemes_file

  print -r "=> $scheme for $mode mode: reload Ghostty with cmd+shift+, and restart nvim"
}
